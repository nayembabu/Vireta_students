# ============================================================
# ViretaDev Student Portal - Production environment template
# Copy this file to .env and fill in your real values.
# ============================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vireta_students
DB_USER=your_db_user
DB_PASS=your_db_password

# Session
SESSION_NAME=vireta_session
SESSION_LIFETIME=7200

# Mailer - use your real SMTP host/credentials
MAIL_HOST=smtp.your-mail-provider.com
MAIL_PORT=587
MAIL_USER=your_smtp_user
MAIL_PASS=your_smtp_password

# Security - generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=replace_with_a_random_64_hex_secret

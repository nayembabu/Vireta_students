# =====================================================================
# ViretaDev Student Portal - Apache config (project root)
# Forces every request through the Slim front controller and protects
# sensitive files.
# =====================================================================

Options -Indexes

# ---- Protect sensitive files ---------------------------------------
<FilesMatch "^\.(env|git|env\.example)$|^composer\.(json|lock)$|^phinx\.php$">
    Require all denied
</FilesMatch>

# ---- Deny direct access to internal directories --------------------
RedirectMatch 403 ^/(cache|logs|database|config|src|vendor|plan)(/|$)

# ---- URL rewriting --------------------------------------------------
RewriteEngine On

# If the URL structure is /public/... serve any real file/dir directly
RewriteRule ^public(/|$) - [L]

# Clean URLs for the webroot sub-folders
RewriteRule ^assets/(.*)$ public/assets/$1 [QSA,L]
RewriteRule ^uploads/(.*)$ public/uploads/$1 [QSA,L]

# Everything else goes through the Slim front controller
RewriteRule ^(.*)$ public/index.php [QSA,L]

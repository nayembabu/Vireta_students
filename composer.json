{
    "name": "vireta/vireta-students",
    "description": "ViretaDev Intern Student Portal",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "cakephp/validation": "^5.0",
        "illuminate/database": "^11.0",
        "monolog/monolog": "^3.6",
        "odan/session": "^6.5",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.4",
        "robmorgan/phinx": "^0.16",
        "slim/csrf": "^1.5",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "slim/twig-view": "^3.4",
        "symfony/mailer": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public public/index.php"
    },
    "config": {
        "sort-packages": true
    }
}

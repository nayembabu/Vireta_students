{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Dashboard{% endblock %}
{% block admin_heading %}Dashboard{% endblock %}

{% block admin_content %}
{# ============ Greeting banner ============ #}
<div class="relative mb-6 overflow-hidden rounded-3xl bg-slate-900 p-6 text-white shadow-xl shadow-slate-900/20 sm:p-8">
    <div class="pointer-events-none absolute inset-0 bg-grid opacity-20"></div>
    <div class="pointer-events-none absolute -top-20 -right-20 h-64 w-64 rounded-full bg-teal-500/25 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-16 h-56 w-56 rounded-full bg-indigo-500/20 blur-3xl"></div>
    <div class="relative">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-teal-400">Cashier dashboard</p>
        <h2 class="mt-1 text-xl font-extrabold sm:text-2xl">Welcome, {{ cashier.name }}! 👋</h2>
        <p class="mt-1 text-sm text-slate-400">{{ cashier.today_label }}</p>
    </div>
</div>

{# ============ Payment stats ============ #}
<div class="grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-4">
    <a href="{{ base_path }}/cashier/payments?status=pending" class="group rounded-2xl bg-white p-4 ring-1 ring-slate-200/70 transition hover:-translate-y-0.5 hover:shadow-lg hover:ring-amber-300 sm:p-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Pending</div>
        <div class="mt-1 text-3xl font-extrabold text-amber-600">{{ counts.pending }}</div>
        <div class="mt-1 text-xs text-slate-400">payments to verify</div>
    </a>
    <a href="{{ base_path }}/cashier/payments?status=verified" class="group rounded-2xl bg-white p-4 ring-1 ring-slate-200/70 transition hover:-translate-y-0.5 hover:shadow-lg hover:ring-teal-300 sm:p-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Verified</div>
        <div class="mt-1 text-3xl font-extrabold text-teal-600">{{ counts.verified }}</div>
        <div class="mt-1 text-xs text-slate-400">confirmed payments</div>
    </a>
    <a href="{{ base_path }}/cashier/payments?status=rejected" class="group rounded-2xl bg-white p-4 ring-1 ring-slate-200/70 transition hover:-translate-y-0.5 hover:shadow-lg hover:ring-rose-300 sm:p-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Rejected</div>
        <div class="mt-1 text-3xl font-extrabold text-rose-600">{{ counts.rejected }}</div>
        <div class="mt-1 text-xs text-slate-400">rejected payments</div>
    </a>
</div>

{# ============ Payments Report ============ #}
<div class="mt-6 grid grid-cols-1 gap-4 sm:gap-6 lg:grid-cols-2">
    <div class="rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
        <div class="mb-4 flex items-center justify-between">
            <h3 class="font-bold text-slate-900">💰 Payments report</h3>
            <a href="{{ base_path }}/cashier/payments" class="text-xs font-semibold text-teal-700 hover:text-teal-600">All →</a>
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl bg-teal-50 p-4">
                <div class="text-[11px] font-bold uppercase tracking-wider text-teal-600">Total collected</div>
                <div class="mt-1 text-2xl font-extrabold text-teal-700">৳ {{ report.total_collected|number_format(0) }}</div>
            </div>
            <div class="rounded-xl bg-amber-50 p-4">
                <div class="text-[11px] font-bold uppercase tracking-wider text-amber-600">Pending amount</div>
                <div class="mt-1 text-2xl font-extrabold text-amber-700">৳ {{ report.pending_amount|number_format(0) }}</div>
            </div>
        </div>
        <div class="mt-4">
            <a href="{{ base_path }}/cashier/payments/create" class="inline-block rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-500">+ Add payment</a>
        </div>
    </div>

    <div class="rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
        <h3 class="mb-4 font-bold text-slate-900">🕐 Recent payments</h3>
        {% if report.recent is empty %}
        <p class="text-sm text-slate-500">No payments yet.</p>
        {% else %}
        <div class="divide-y divide-slate-50">
            {% for p in report.recent %}
            <div class="flex items-center gap-3 py-2.5">
                <div class="min-w-0 flex-1">
                    <div class="truncate text-sm font-semibold text-slate-800">{{ p.student }}</div>
                    <div class="truncate text-xs text-slate-400">{{ p.course }} · {{ p.trx_id }}</div>
                </div>
                <span class="shrink-0 text-sm font-bold text-slate-800">৳ {{ p.amount|number_format(0) }}</span>
                {% if p.status == 'verified' %}<span class="shrink-0 rounded-full bg-teal-50 px-2 py-0.5 text-[11px] font-bold text-teal-700">✓</span>
                {% elseif p.status == 'rejected' %}<span class="shrink-0 rounded-full bg-rose-50 px-2 py-0.5 text-[11px] font-bold text-rose-600">✕</span>
                {% else %}<span class="shrink-0 rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-bold text-amber-700">⏳</span>{% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

{# ============ Batch-wise Students ============ #}
<div class="mt-6 rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
    <div class="mb-4 flex items-center justify-between">
        <h3 class="font-bold text-slate-900">👥 Batch-wise students</h3>
        <a href="{{ base_path }}/cashier/payments" class="text-xs font-semibold text-teal-700 hover:text-teal-600">Payments →</a>
    </div>
    {% if batch_groups is empty %}
    <p class="text-sm text-slate-500">No students yet.</p>
    {% else %}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% for batch, students in batch_groups %}
        <div class="rounded-xl border border-slate-100 p-4">
            <h4 class="mb-3 text-sm font-bold text-slate-800">🗂️ {{ batch }} <span class="text-xs font-semibold text-slate-400">({{ students|length }})</span></h4>
            <div class="space-y-2">
                {% for s in students %}
                <div class="flex items-center gap-2">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-teal-50 text-[11px] font-bold text-teal-700">{{ s.name|slice(0,1) }}</span>
                    <div class="min-w-0">
                        <div class="truncate text-sm font-semibold text-slate-700">{{ s.name }}</div>
                        <div class="truncate text-xs text-slate-400">{{ s.email }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}

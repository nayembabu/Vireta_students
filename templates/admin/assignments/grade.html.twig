{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Grade submission{% endblock %}
{% block admin_heading %}Grade submission{% endblock %}

{% block admin_content %}
<div class="mx-auto max-w-2xl">
    <a href="{{ base_path }}{{ staff_base }}/assignments" class="mb-4 inline-block text-sm font-semibold text-teal-700 hover:text-teal-600">← Back to assignments</a>

    <div class="mb-4 rounded-2xl bg-white p-5 ring-1 ring-slate-200/70">
        <h3 class="font-bold text-slate-900">{{ submission.assignment_title }}</h3>
        <p class="mt-0.5 text-xs text-slate-500">{{ submission.course }} · Max score {{ submission.max_score }}</p>
        <div class="mt-3 flex flex-wrap gap-2 text-xs">
            <span class="rounded-full bg-slate-100 px-2 py-0.5 font-semibold text-slate-600">Student: {{ submission.student }}</span>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 font-semibold text-slate-600">Version {{ submission.version }}</span>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 font-semibold text-slate-600">Submitted {{ submission.submitted_at }}</span>
        </div>
    </div>

    <div class="rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
        <h4 class="mb-2 font-bold text-slate-900">Submission</h4>
        {% if submission.text %}
        <div class="mb-4 rounded-xl bg-slate-50 p-4 text-sm text-slate-700 whitespace-pre-wrap">{{ submission.text }}</div>
        {% else %}
        <p class="mb-4 text-sm text-slate-500">No text answer submitted.</p>
        {% endif %}

        {% if submission.file_path %}
        <p class="mb-4 text-sm">
            <a href="{{ upload(submission.file_path) }}" target="_blank" class="font-semibold text-teal-700 hover:text-teal-600">📎 View attached file</a>
        </p>
        {% endif %}

        <form method="post" action="{{ base_path }}{{ staff_base }}/assignments/grade/{{ submission.id }}">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">

            <div class="space-y-4">
                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-700">Score (0-{{ submission.max_score }}) *</label>
                    <input type="number" name="score" value="{{ old.score }}" min="0" max="{{ submission.max_score }}"
                       class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-teal-400 focus:outline-none">
                    {% if errors.score %}<p class="mt-1 text-xs text-rose-500">{{ errors.score }}</p>{% endif %}
                </div>

                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-700">Feedback</label>
                    <textarea name="feedback" rows="4"
                       class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-teal-400 focus:outline-none">{{ old.feedback }}</textarea>
                </div>

                <div class="flex gap-3 pt-2">
                    <button type="submit" class="rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-500">Save grade</button>
                    <a href="{{ base_path }}{{ staff_base }}/assignments" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-50">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}

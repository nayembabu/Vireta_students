{% extends 'admin/layout.html.twig' %}

{% block admin_title %}{{ assignment ? 'Edit assignment' : 'Add assignment' }}{% endblock %}
{% block admin_heading %}{{ assignment ? 'Edit assignment' : 'Add assignment' }}{% endblock %}

{% block admin_content %}
<div class="mx-auto max-w-xl">
    <div class="rounded-2xl bg-white p-6 ring-1 ring-slate-200/70">
        <form method="post" action="{{ assignment ? base_path ~ staff_base ~ '/assignments/' ~ assignment.id ~ '/edit' : base_path ~ staff_base ~ '/assignments/create' }}">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">

            <div class="space-y-4">
                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-700">Course *</label>
                    <select name="course_id" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-teal-400 focus:outline-none">
                        <option value="">Select course</option>
                        {% for c in courses %}
                        <option value="{{ c.id }}" {{ old.course_id == c.id ? 'selected' : '' }}>{{ c.title }}</option>
                        {% endfor %}
                    </select>
                    {% if errors.course_id %}<p class="mt-1 text-xs text-rose-500">{{ errors.course_id }}</p>{% endif %}
                </div>

                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-700">Title *</label>
                    <input type="text" name="title" value="{{ old.title }}"
                       class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-teal-400 focus:outline-none">
                    {% if errors.title %}<p class="mt-1 text-xs text-rose-500">{{ errors.title }}</p>{% endif %}
                </div>

                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-700">Description</label>
                    <textarea name="description" rows="3"
                       class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-teal-400 focus:outline-none">{{ old.description }}</textarea>
                </div>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-sm font-semibold text-slate-700">Due date &amp; time</label>
                        <input type="datetime-local" name="due_date" value="{{ old.due_date }}"
                           class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-teal-400 focus:outline-none">
                        {% if errors.due_date %}<p class="mt-1 text-xs text-rose-500">{{ errors.due_date }}</p>{% endif %}
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-semibold text-slate-700">Max score</label>
                        <input type="number" name="max_score" value="{{ old.max_score }}" min="1"
                           class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-teal-400 focus:outline-none">
                    </div>
                </div>

                <div class="flex gap-3 pt-2">
                    <button type="submit" class="rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-500">{{ assignment ? 'Save changes' : 'Add assignment' }}</button>
                    <a href="{{ base_path }}/admin/assignments" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-50">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Students{% endblock %}
{% block admin_heading %}Students{% endblock %}

{% block admin_content %}
<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <form method="get" action="{{ base_path }}/admin/students" class="flex flex-wrap items-center gap-2">
        <input type="text" name="q" value="{{ filters.q }}" placeholder="Search name / reg no / phone"
               class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-teal-400 focus:outline-none">
        <select name="status" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-teal-400 focus:outline-none">
            <option value="">All status</option>
            <option value="pending" {{ filters.status == 'pending' ? 'selected' : '' }}>Pending</option>
            <option value="registered" {{ filters.status == 'registered' ? 'selected' : '' }}>Registered</option>
            <option value="blocked" {{ filters.status == 'blocked' ? 'selected' : '' }}>Blocked</option>
        </select>
        <select name="batch" class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-teal-400 focus:outline-none">
            <option value="">All batches</option>
            {% for b in batches %}
            <option value="{{ b.id }}" {{ filters.batch == b.id ? 'selected' : '' }}>{{ b.name }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700">Filter</button>
    </form>
    <div class="flex gap-2">
        <a href="{{ base_path }}/admin/students/import" class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">⬆ Import CSV</a>
        <a href="{{ base_path }}/admin/students/create" class="rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-500">+ Add student</a>
    </div>
</div>

<div class="overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200/70">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="border-b border-slate-100 bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
                <tr>
                    <th class="px-4 py-3">Student</th>
                    <th class="px-4 py-3">Reg no</th>
                    <th class="px-4 py-3">Batch</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3">Account</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                {% for s in items %}
                <tr class="transition hover:bg-slate-50/60">
                    <td class="px-4 py-3">
                        <a href="{{ base_path }}/admin/students/{{ s.id }}" class="font-semibold text-slate-800 hover:text-teal-700">{{ s.name }}</a>
                        <div class="text-xs text-slate-400">{{ s.phone }}</div>
                    </td>
                    <td class="px-4 py-3 font-mono text-xs text-slate-600">{{ s.reg_no }}</td>
                    <td class="px-4 py-3 text-xs text-slate-500">{{ s.batch ?? '—' }}</td>
                    <td class="px-4 py-3">
                        {% if s.status == 'registered' %}
                        <span class="rounded-full bg-teal-50 px-2 py-0.5 text-[11px] font-bold text-teal-700">Registered</span>
                        {% elseif s.status == 'blocked' %}
                        <span class="rounded-full bg-rose-50 px-2 py-0.5 text-[11px] font-bold text-rose-600">Blocked</span>
                        {% else %}
                        <span class="rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-bold text-amber-700">Pending</span>
                        {% endif %}
                    </td>
                    <td class="px-4 py-3 text-xs text-slate-500">{{ s.account_email ?? '—' }}</td>
                    <td class="px-4 py-3">
                        <div class="flex justify-end gap-1.5">
                            <a href="{{ base_path }}/admin/students/{{ s.id }}" class="rounded-lg px-2 py-1 text-xs font-semibold text-slate-500 hover:bg-slate-100" title="View">👁</a>
                            <a href="{{ base_path }}/admin/students/{{ s.id }}/edit" class="rounded-lg px-2 py-1 text-xs font-semibold text-slate-500 hover:bg-slate-100" title="Edit">✏️</a>
                            <form method="post" action="{{ base_path }}/admin/students/{{ s.id }}/block">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <button type="submit" class="rounded-lg px-2 py-1 text-xs font-semibold {{ s.status == 'blocked' ? 'text-teal-600 hover:bg-teal-50' : 'text-rose-500 hover:bg-rose-50' }}" title="{{ s.status == 'blocked' ? 'Unblock' : 'Block' }}">
                                    {{ s.status == 'blocked' ? '🔓' : '🔒' }}
                                </button>
                            </form>
                            {% if not s.registered %}
                            <form method="post" action="{{ base_path }}/admin/students/{{ s.id }}/delete" onsubmit="return confirm('Delete this pre-record?');">
                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                <button type="submit" class="rounded-lg px-2 py-1 text-xs font-semibold text-slate-400 hover:bg-rose-50 hover:text-rose-500" title="Delete">🗑</button>
                            </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="6" class="px-4 py-8 text-center text-sm text-slate-400">No students found.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

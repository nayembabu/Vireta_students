{% extends 'app/layout.html.twig' %}

{% block page_title %}Fees & Payments{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-extrabold text-slate-900">Fees & Payments</h1>
        <p class="text-sm text-slate-500 mt-1">Your course fees and payment history.</p>
    </div>
</div>

{% if data.courses is empty %}
<div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-8 text-center">
    <p class="text-slate-500">You are not enrolled in any course yet, so there are no fees to show.</p>
</div>
{% else %}

<div class="grid grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-2xl ring-1 ring-slate-100 p-4">
        <div class="text-sm text-slate-500">Total fee</div>
        <div class="text-2xl font-extrabold text-slate-900 mt-1">৳ {{ data.total.fee|number_format(0) }}</div>
    </div>
    <div class="bg-emerald-50 ring-1 ring-emerald-200 rounded-2xl p-4">
        <div class="text-sm text-emerald-700">Paid</div>
        <div class="text-2xl font-extrabold text-emerald-600 mt-1">৳ {{ data.total.paid|number_format(0) }}</div>
    </div>
    <div class="bg-rose-50 ring-1 ring-rose-200 rounded-2xl p-4">
        <div class="text-sm text-rose-700">Due</div>
        <div class="text-2xl font-extrabold text-rose-600 mt-1">৳ {{ data.total.due|number_format(0) }}</div>
    </div>
</div>

{% for c in data.courses %}
<div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6 mb-6">
    <div class="flex items-start justify-between">
        <div>
            <h2 class="font-bold text-slate-900">{{ c.course }}</h2>
            <p class="text-xs text-slate-500 mt-0.5">{{ batch|default('') }}</p>
        </div>
        {% if c.full_paid %}
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700">Fee completed</span>
        {% endif %}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4">
        <div class="rounded-xl bg-slate-50 p-3">
            <div class="text-xs text-slate-500">Total fee</div>
            <div class="font-bold text-slate-800">৳ {{ c.fee|number_format(0) }}</div>
        </div>
        <div class="rounded-xl bg-emerald-50 p-3">
            <div class="text-xs text-emerald-700">Paid</div>
            <div class="font-bold text-emerald-700">৳ {{ c.paid|number_format(0) }}</div>
        </div>
        {% if c.due > 0 %}
        <div class="rounded-xl bg-rose-50 p-3">
            <div class="text-xs text-rose-700">Due</div>
            <div class="font-bold text-rose-700">৳ {{ c.due|number_format(0) }}</div>
        </div>
        {% else %}
        <div class="rounded-xl bg-emerald-50 p-3">
            <div class="text-xs text-emerald-700">Due</div>
            <div class="font-bold text-emerald-700">৳ 0</div>
        </div>
        {% endif %}
    </div>

    <div class="mt-4 space-y-2 text-sm">
        {% if c.deadline %}
        <div class="flex items-center justify-between">
            <span class="text-slate-500">Payment deadline</span>
            <span class="font-semibold {{ c.deadline_passed ? 'text-rose-600' : 'text-slate-800' }}">{{ c.deadline }}</span>
        </div>
        {% endif %}
        {% if c.deadline_passed %}
        <div class="rounded-lg bg-rose-50 text-rose-700 text-xs px-3 py-2">Your due fee payment deadline has passed.</div>
        {% endif %}
        {% if c.last_payment %}
        <div class="flex items-center justify-between">
            <span class="text-slate-500">Last payment</span>
            <span class="font-semibold text-slate-800">৳ {{ c.last_payment.amount|number_format(0) }} · {{ c.last_payment.date }} · {{ c.last_payment.trx_id }}</span>
        </div>
        {% endif %}
    </div>

    <div class="mt-4 flex items-center gap-3">
        <a href="#pay-form" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2.5">
            Submit new payment
        </a>
        {% if c.pending_count > 0 %}
        <span class="text-xs text-amber-600">⏳ {{ c.pending_count }} payment(s) under review</span>
        {% endif %}
    </div>
</div>
{% endfor %}

{% endif %}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6">
        <h2 class="font-bold text-slate-900 mb-4">Payment history</h2>
        {% if history is empty %}
        <p class="text-sm text-slate-500">No payments yet.</p>
        {% else %}
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-xs text-slate-500 border-b border-slate-100">
                        <th class="py-2 pr-3">Date</th>
                        <th class="py-2 pr-3">Course</th>
                        <th class="py-2 pr-3">TRX ID</th>
                        <th class="py-2 pr-3">Sender</th>
                        <th class="py-2 pr-3 text-right">Amount</th>
                        <th class="py-2">Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for h in history %}
                    <tr class="border-b border-slate-50">
                        <td class="py-2.5 pr-3 text-slate-600">{{ h.date }}</td>
                        <td class="py-2.5 pr-3 text-slate-600">{{ h.course }}</td>
                        <td class="py-2.5 pr-3 font-mono text-slate-800">{{ h.trx_id }}</td>
                        <td class="py-2.5 pr-3 text-slate-600">{{ h.sender_number }}</td>
                        <td class="py-2.5 pr-3 text-right font-semibold text-slate-800">৳ {{ h.amount|number_format(0) }}</td>
                        <td class="py-2.5">
                            {% if h.status == 'verified' %}
                            <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-xs font-bold">Verified</span>
                            {% elseif h.status == 'pending' %}
                            <span class="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-700 text-xs font-bold">Under review</span>
                            {% else %}
                            <span class="px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-700 text-xs font-bold">Rejected</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>

    <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6" id="pay-form">
        <h2 class="font-bold text-slate-900 mb-4">New payment</h2>

        {% if errors.course_id or errors.trx_id or errors.sender_number or errors.amount or errors.screenshot %}
        <div class="mb-4 rounded-xl bg-rose-50 border border-rose-200 px-4 py-3 text-sm text-rose-700">
            There are some errors in the form — please fix them as instructed below.
        </div>
        {% endif %}

        <form method="post" action="{{ base_path }}/fees/pay" enctype="multipart/form-data" class="space-y-4">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Course *</label>
                <select name="course_id" class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm">
                    <option value="">Select course</option>
                    {% for c in courses %}
                    <option value="{{ c.id }}" {{ old.course_id == c.id ? 'selected' : '' }}>{{ c.title }}</option>
                    {% endfor %}
                </select>
                {% if errors.course_id %}<p class="text-xs text-rose-600 mt-1">{{ errors.course_id }}</p>{% endif %}
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Payment number (TRX ID) *</label>
                <input type="text" name="trx_id" value="{{ old.trx_id }}"
                    class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm" placeholder="e.g. TRX1234567890">
                {% if errors.trx_id %}<p class="text-xs text-rose-600 mt-1">{{ errors.trx_id }}</p>{% endif %}
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Sender number *</label>
                <input type="text" name="sender_number" value="{{ old.sender_number }}"
                    class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm" placeholder="01XXXXXXXXX">
                {% if errors.sender_number %}<p class="text-xs text-rose-600 mt-1">{{ errors.sender_number }}</p>{% endif %}
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Amount (৳) *</label>
                <input type="text" name="amount" value="{{ old.amount }}"
                    class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm" placeholder="2000">
                {% if errors.amount %}<p class="text-xs text-rose-600 mt-1">{{ errors.amount }}</p>{% endif %}
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Screenshot (optional)</label>
                <input type="file" name="screenshot" accept=".jpg,.jpeg,.png,.pdf"
                    class="w-full text-sm text-slate-600">
                {% if errors.screenshot %}<p class="text-xs text-rose-600 mt-1">{{ errors.screenshot }}</p>{% endif %}
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Note (optional)</label>
                <textarea name="note" rows="2"
                    class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm">{{ old.note }}</textarea>
            </div>

            <button type="submit" class="w-full rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold py-3">
                Submit payment
            </button>
        </form>
    </div>
</div>
{% endblock %}

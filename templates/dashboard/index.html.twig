{% extends 'app/layout.html.twig' %}

{% block page_title %}Dashboard{% endblock %}

{% block content %}
{# ============ Greeting banner ============ #}
<div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 via-violet-600 to-fuchsia-600 p-6 sm:p-8 text-white shadow-xl shadow-indigo-200/60 mb-6">
    <div class="pointer-events-none absolute -top-16 -right-16 h-56 w-56 rounded-full bg-white/10 blur-2xl"></div>
    <div class="relative flex flex-col sm:flex-row sm:items-center gap-5">
        <img src="{{ data.greeting.pro_pic ? upload(data.greeting.pro_pic) : upload('logo/logo2.png') }}"
             alt="avatar"
             class="h-16 w-16 rounded-2xl object-cover ring-2 ring-white/40 shadow-lg">
        <div class="flex-1">
            <h1 class="text-xl sm:text-2xl font-extrabold">Welcome, {{ data.greeting.name }}!</h1>
            <p class="text-sm text-indigo-100 mt-1">{{ data.greeting.batch }} · {{ data.greeting.today_label }}</p>
            <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold">
                <span class="rounded-full bg-white/15 backdrop-blur px-3 py-1.5">📘 {{ data.chips.courses }} courses</span>
                <span class="rounded-full bg-white/15 backdrop-blur px-3 py-1.5">📊 {{ data.chips.attendance_pct }}% attendance</span>
                <span class="rounded-full bg-white/15 backdrop-blur px-3 py-1.5">🔖 {{ data.chips.pending_assignments }} pending</span>
            </div>
        </div>
    </div>
</div>

{# ============ Stat cards ============ #}
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <a href="{{ base_path }}/attendance" class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-5 hover:ring-indigo-200 transition">
        <div class="text-sm text-slate-500">Attendance rate</div>
        <div class="text-3xl font-extrabold text-emerald-600 mt-1">{{ data.stats.attendance_pct }}%</div>
    </a>
    <a href="{{ base_path }}/fees" class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-5 hover:ring-indigo-200 transition">
        <div class="text-sm text-slate-500">Due fees</div>
        <div class="text-3xl font-extrabold {{ data.stats.due_fee > 0 ? 'text-rose-600' : 'text-emerald-600' }} mt-1">
            ৳ {{ data.stats.due_fee|number_format(0) }}{% if data.stats.deadline_passed %} <span class="text-base">⚠</span>{% endif %}
        </div>
    </a>
    <a href="{{ base_path }}/assignments" class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-5 hover:ring-indigo-200 transition">
        <div class="text-sm text-slate-500">Pending assignments</div>
        <div class="text-3xl font-extrabold {{ data.stats.pending_assignments > 0 ? 'text-amber-600' : 'text-emerald-600' }} mt-1">{{ data.stats.pending_assignments }}</div>
    </a>
    <a href="#notifications" class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-5 hover:ring-indigo-200 transition">
        <div class="text-sm text-slate-500">Unread notifications</div>
        <div class="text-3xl font-extrabold {{ data.stats.unread_notifications > 0 ? 'text-indigo-600' : 'text-emerald-600' }} mt-1">{{ data.stats.unread_notifications }}</div>
    </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    {# ============ Class overview ============ #}
    <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="font-bold text-slate-900">📅 Class overview</h2>
            <a href="{{ base_path }}/routine" class="text-xs font-semibold text-indigo-600 hover:text-indigo-700">Full routine →</a>
        </div>
        {% if data.classes is empty %}
        <p class="text-sm text-slate-500">No classes around today.</p>
        {% else %}
        <div class="space-y-2.5">
            {% for c in data.classes %}
            <div class="flex items-center gap-3 rounded-xl border px-4 py-3 {{ c.is_today ? 'border-indigo-200 bg-indigo-50/60' : 'border-slate-100' }}">
                <div class="w-14 text-center shrink-0">
                    <div class="text-xs font-bold {{ c.is_today ? 'text-indigo-600' : 'text-slate-500' }}">
                        {{ c.is_today ? 'Today' : c.session_date|date('D') }}
                    </div>
                    <div class="text-[11px] text-slate-400">{{ c.session_date|date('d M') }}</div>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="truncate text-sm font-semibold text-slate-800">{{ c.topic }}</div>
                    <div class="text-xs text-slate-400">{{ c.course }}{% if c.room %} · {{ c.room }}{% endif %}</div>
                </div>
                <span class="text-xs font-semibold text-slate-500 shrink-0">{{ c.start_time|slice(0,5) }}-{{ c.end_time|slice(0,5) }}</span>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    {# ============ Assignments ============ #}
    <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="font-bold text-slate-900">🔖 Assignments</h2>
            <a href="{{ base_path }}/assignments" class="text-xs font-semibold text-indigo-600 hover:text-indigo-700">All →</a>
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl bg-amber-50 p-3.5">
                <div class="text-2xl font-extrabold text-amber-600">{{ data.assignments.open }}</div>
                <div class="text-xs font-semibold text-amber-800 mt-0.5">Open (submit now)</div>
            </div>
            <div class="rounded-xl bg-rose-50 p-3.5">
                <div class="text-2xl font-extrabold text-rose-600">{{ data.assignments.missed }}</div>
                <div class="text-xs font-semibold text-rose-800 mt-0.5">Missed</div>
            </div>
            <div class="rounded-xl bg-indigo-50 p-3.5">
                <div class="text-2xl font-extrabold text-indigo-600">{{ data.assignments.submitted }}</div>
                <div class="text-xs font-semibold text-indigo-800 mt-0.5">Submitted (grading)</div>
            </div>
            <div class="rounded-xl bg-emerald-50 p-3.5">
                <div class="text-2xl font-extrabold text-emerald-600">{{ data.assignments.graded }}</div>
                <div class="text-xs font-semibold text-emerald-800 mt-0.5">Graded ✓</div>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    {# ============ Course progress ============ #}
    <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6">
        <h2 class="font-bold text-slate-900 mb-4">📚 Course progress</h2>
        <div class="mb-4">
            <div class="flex justify-between text-xs text-slate-500"><span>Overall</span><span>{{ data.progress.overall }}%</span></div>
            <div class="mt-1 h-2 rounded-full bg-slate-100">
                <div class="h-2 rounded-full bg-gradient-to-r from-indigo-500 to-fuchsia-500" style="width: {{ data.progress.overall }}%"></div>
            </div>
        </div>
        {% if data.progress.courses is empty %}
        <p class="text-sm text-slate-500">No courses yet.</p>
        {% else %}
        <div class="space-y-3">
            {% for c in data.progress.courses %}
            <div>
                <div class="flex justify-between text-sm">
                    <span class="font-semibold text-slate-700">{{ c.course }}</span>
                    <span class="text-xs text-slate-400">{{ c.done }}/{{ c.total }} lessons · {{ c.pct }}%</span>
                </div>
                <div class="mt-1 h-1.5 rounded-full bg-slate-100">
                    <div class="h-1.5 rounded-full bg-gradient-to-r from-cyan-500 to-sky-500" style="width: {{ c.pct }}%"></div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    {# ============ Fee status ============ #}
    <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="font-bold text-slate-900">💳 Fee status</h2>
            <a href="{{ base_path }}/fees" class="text-xs font-semibold text-indigo-600 hover:text-indigo-700">Fees →</a>
        </div>
        {% if data.fees.courses is empty %}
        <p class="text-sm text-slate-500">No courses yet.</p>
        {% else %}
        <div class="space-y-3">
            {% for c in data.fees.courses %}
            <div class="rounded-xl border border-slate-100 p-3.5">
                <div class="flex justify-between items-center">
                    <span class="font-semibold text-slate-700 text-sm">{{ c.course }}</span>
                    {% if c.full_paid %}
                    <span class="text-xs font-bold text-emerald-600">Paid ✓</span>
                    {% endif %}
                </div>
                <div class="mt-2 flex justify-between text-xs text-slate-500">
                    <span>Paid: <b class="text-emerald-600">৳ {{ c.paid|number_format(0) }}</b></span>
                    <span>Due: <b class="{{ c.due > 0 ? 'text-rose-600' : 'text-emerald-600' }}">৳ {{ c.due|number_format(0) }}</b></span>
                </div>
                {% if c.deadline and c.due > 0 %}
                <div class="mt-2 text-xs {{ c.deadline_passed ? 'text-rose-600 font-semibold' : 'text-slate-400' }}">
                    Deadline: {{ c.deadline }}{% if c.deadline_passed %} ⚠ passed{% endif %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

{# ============ Notifications ============ #}
<div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6" id="notifications">
    <h2 class="font-bold text-slate-900 mb-4">🔔 Notifications</h2>
    {% if data.notifications is empty %}
    <p class="text-sm text-slate-500">No notifications yet.</p>
    {% else %}
    <div class="divide-y divide-slate-50">
        {% for n in data.notifications %}
        <div class="flex items-start gap-3 py-3 {{ n.is_read ? 'opacity-60' : '' }}">
            <span class="mt-1.5 h-2 w-2 rounded-full shrink-0 {{ n.is_read ? 'bg-slate-200' : 'bg-rose-500' }}"></span>
            <div class="min-w-0">
                <div class="text-sm font-semibold text-slate-800">{{ n.title }}</div>
                <div class="text-xs text-slate-500 mt-0.5">{{ n.body }}</div>
            </div>
            <span class="ml-auto text-[11px] text-slate-400 shrink-0">{{ n.created_at }}</span>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}

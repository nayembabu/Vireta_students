{% extends 'app/layout.html.twig' %}

{% block page_title %}Dashboard{% endblock %}
{% block page_heading %}Dashboard{% endblock %}

{% block content %}
{# ============ Greeting banner ============ #}
<div class="reveal relative overflow-hidden rounded-3xl bg-slate-900 p-6 text-white shadow-xl shadow-slate-900/20 sm:p-8 mb-6">
    <div class="pointer-events-none absolute inset-0 bg-grid opacity-20"></div>
    <div class="pointer-events-none absolute -top-20 -right-20 h-64 w-64 rounded-full bg-teal-500/25 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-16 h-56 w-56 rounded-full bg-indigo-500/20 blur-3xl"></div>

    <div class="relative flex flex-col gap-5 sm:flex-row sm:items-center">
        <img src="{{ data.greeting.pro_pic ? upload(data.greeting.pro_pic) : upload('logo/logo2.png') }}"
             alt="avatar"
             class="h-16 w-16 shrink-0 rounded-2xl object-cover ring-2 ring-teal-400/50 shadow-lg">
        <div class="flex-1 min-w-0">
            <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-teal-400">Student dashboard</p>
            <h2 class="text-xl font-extrabold leading-tight mt-0.5 sm:text-2xl">Welcome back, {{ data.greeting.name }}! 👋</h2>
            <p class="text-sm text-slate-400 mt-1">
                {% if data.greeting.role %}{{ data.greeting.role }}{% if data.greeting.batch %} · {{ data.greeting.batch }}{% endif %} · {% endif %}{{ data.greeting.today_label }}
            </p>
            <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 ring-1 ring-white/10">📘 {{ data.chips.courses }} courses</span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 ring-1 ring-white/10">📊 {{ data.chips.attendance_pct }}% attendance</span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 ring-1 ring-white/10">🔖 {{ data.chips.pending_assignments }} pending</span>
            </div>
        </div>
    </div>
</div>

{# ============ Stat cards ============ #}
<div class="grid grid-cols-2 gap-3 mb-6 lg:grid-cols-4 sm:gap-4">
    <a href="{{ base_path }}/attendance" class="group bg-white rounded-2xl ring-1 ring-slate-200/70 p-4 sm:p-5 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-teal-900/5 hover:ring-teal-300">
        <div class="mb-3 flex items-center justify-between">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-50 text-teal-600 transition group-hover:bg-teal-600 group-hover:text-white">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-teal-600">Attendance</span>
        </div>
        <div class="text-2xl font-extrabold text-slate-900 sm:text-3xl">{{ data.stats.attendance_pct }}<span class="text-base font-bold text-slate-400">%</span></div>
        <div class="mt-0.5 text-xs text-slate-400">rate so far</div>
    </a>

    <a href="{{ base_path }}/fees" class="group bg-white rounded-2xl ring-1 ring-slate-200/70 p-4 sm:p-5 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-teal-900/5 hover:ring-teal-300">
        <div class="mb-3 flex items-center justify-between">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl {{ data.stats.due_fee > 0 ? 'bg-rose-50 text-rose-600 group-hover:bg-rose-600 group-hover:text-white' : 'bg-teal-50 text-teal-600 group-hover:bg-teal-600 group-hover:text-white' }} transition">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider {{ data.stats.due_fee > 0 ? 'text-rose-600' : 'text-teal-600' }}">Due fees</span>
        </div>
        <div class="text-2xl font-extrabold {{ data.stats.due_fee > 0 ? 'text-rose-600' : 'text-slate-900' }} sm:text-3xl">
            ৳ {{ data.stats.due_fee|number_format(0) }}{% if data.stats.deadline_passed %} <span class="text-base">⚠️</span>{% endif %}
        </div>
        <div class="mt-0.5 text-xs text-slate-400">{{ data.stats.due_fee > 0 ? 'payment due' : 'all clear' }}</div>
    </a>

    <a href="{{ base_path }}/assignments" class="group bg-white rounded-2xl ring-1 ring-slate-200/70 p-4 sm:p-5 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-teal-900/5 hover:ring-teal-300">
        <div class="mb-3 flex items-center justify-between">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-600 transition group-hover:bg-amber-500 group-hover:text-white">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-amber-600">Assignments</span>
        </div>
        <div class="text-2xl font-extrabold {{ data.stats.pending_assignments > 0 ? 'text-amber-600' : 'text-slate-900' }} sm:text-3xl">{{ data.stats.pending_assignments }}</div>
        <div class="mt-0.5 text-xs text-slate-400">pending now</div>
    </a>

    <a href="#notifications" class="group bg-white rounded-2xl ring-1 ring-slate-200/70 p-4 sm:p-5 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-teal-900/5 hover:ring-teal-300">
        <div class="mb-3 flex items-center justify-between">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-50 text-sky-600 transition group-hover:bg-sky-600 group-hover:text-white">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/></svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-sky-600">Alerts</span>
        </div>
        <div class="text-2xl font-extrabold {{ data.stats.unread_notifications > 0 ? 'text-sky-600' : 'text-slate-900' }} sm:text-3xl">{{ data.stats.unread_notifications }}</div>
        <div class="mt-0.5 text-xs text-slate-400">unread</div>
    </a>
</div>

{# ============ Class overview + Assignments ============ #}
<div class="mb-6 grid grid-cols-1 gap-4 sm:gap-6 lg:grid-cols-2">
    <div class="reveal reveal-delay-1 bg-white rounded-2xl p-5 ring-1 ring-slate-200/70 sm:p-6">
        <div class="mb-4 flex items-center justify-between">
            <h3 class="flex items-center gap-2 font-bold text-slate-900">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-900 text-teal-400">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                </span>
                Class overview
            </h3>
            <a href="{{ base_path }}/routine" class="text-xs font-semibold text-teal-700 hover:text-teal-600">Full routine →</a>
        </div>
        {% if data.classes is empty %}
        <p class="text-sm text-slate-500">No classes around today.</p>
        {% else %}
        <div class="space-y-2.5">
            {% for c in data.classes %}
            <div class="flex items-center gap-3 rounded-xl border px-3 py-3 sm:px-4 {{ c.is_today ? 'border-teal-200 bg-teal-50/60' : 'border-slate-100' }}">
                <div class="w-14 shrink-0 text-center">
                    <div class="text-xs font-bold {{ c.is_today ? 'text-teal-600' : 'text-slate-500' }}">
                        {{ c.is_today ? 'Today' : c.session_date|date('D') }}
                    </div>
                    <div class="text-[11px] text-slate-400">{{ c.session_date|date('d M') }}</div>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="truncate text-sm font-semibold text-slate-800">{{ c.topic }}</div>
                    <div class="truncate text-xs text-slate-400">{{ c.course }}{% if c.room %} · {{ c.room }}{% endif %}</div>
                </div>
                <span class="shrink-0 font-mono text-[11px] font-medium text-slate-500 sm:text-xs">{{ c.start_time|slice(0,5) }}-{{ c.end_time|slice(0,5) }}</span>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    <div class="reveal reveal-delay-2 bg-white rounded-2xl p-5 ring-1 ring-slate-200/70 sm:p-6">
        <div class="mb-4 flex items-center justify-between">
            <h3 class="flex items-center gap-2 font-bold text-slate-900">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                </span>
                Assignments
            </h3>
            <a href="{{ base_path }}/assignments" class="text-xs font-semibold text-teal-700 hover:text-teal-600">All →</a>
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl bg-amber-50 p-3.5">
                <div class="text-2xl font-extrabold text-amber-600">{{ data.assignments.open }}</div>
                <div class="mt-0.5 text-xs font-semibold text-amber-800">Open (submit now)</div>
            </div>
            <div class="rounded-xl bg-rose-50 p-3.5">
                <div class="text-2xl font-extrabold text-rose-600">{{ data.assignments.missed }}</div>
                <div class="mt-0.5 text-xs font-semibold text-rose-800">Missed</div>
            </div>
            <div class="rounded-xl bg-sky-50 p-3.5">
                <div class="text-2xl font-extrabold text-sky-600">{{ data.assignments.submitted }}</div>
                <div class="mt-0.5 text-xs font-semibold text-sky-800">Submitted (grading)</div>
            </div>
            <div class="rounded-xl bg-teal-50 p-3.5">
                <div class="text-2xl font-extrabold text-teal-600">{{ data.assignments.graded }}</div>
                <div class="mt-0.5 text-xs font-semibold text-teal-800">Graded ✓</div>
            </div>
        </div>
    </div>
</div>

{# ============ Course progress + Fee status ============ #}
<div class="mb-6 grid grid-cols-1 gap-4 sm:gap-6 lg:grid-cols-2">
    <div class="reveal reveal-delay-1 bg-white rounded-2xl p-5 ring-1 ring-slate-200/70 sm:p-6">
        <h3 class="mb-4 flex items-center gap-2 font-bold text-slate-900">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-50 text-sky-600">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>
            </span>
            Course progress
        </h3>
        <div class="mb-4">
            <div class="flex justify-between text-xs text-slate-500"><span>Overall</span><span class="font-bold text-slate-700">{{ data.progress.overall }}%</span></div>
            <div class="mt-1 h-2 overflow-hidden rounded-full bg-slate-100">
                <div class="h-2 rounded-full bg-gradient-to-r from-teal-500 to-emerald-500 transition-all duration-700" style="width: {{ data.progress.overall }}%"></div>
            </div>
        </div>
        {% if data.progress.courses is empty %}
        <p class="text-sm text-slate-500">No courses yet.</p>
        {% else %}
        <div class="space-y-3">
            {% for c in data.progress.courses %}
            <div>
                <div class="flex justify-between gap-2 text-sm">
                    <span class="truncate font-semibold text-slate-700">{{ c.course }}</span>
                    <span class="shrink-0 text-xs text-slate-400">{{ c.done }}/{{ c.total }} lessons · {{ c.pct }}%</span>
                </div>
                <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-100">
                    <div class="h-1.5 rounded-full bg-gradient-to-r from-cyan-500 to-teal-500" style="width: {{ c.pct }}%"></div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    <div class="reveal reveal-delay-2 bg-white rounded-2xl p-5 ring-1 ring-slate-200/70 sm:p-6">
        <div class="mb-4 flex items-center justify-between">
            <h3 class="flex items-center gap-2 font-bold text-slate-900">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-teal-50 text-teal-600">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/></svg>
                </span>
                Fee status
            </h3>
            <a href="{{ base_path }}/fees" class="text-xs font-semibold text-teal-700 hover:text-teal-600">Fees →</a>
        </div>
        {% if data.fees.courses is empty %}
        <p class="text-sm text-slate-500">No courses yet.</p>
        {% else %}
        <div class="space-y-3">
            {% for c in data.fees.courses %}
            <div class="rounded-xl border border-slate-100 p-3.5">
                <div class="flex items-center justify-between gap-2">
                    <span class="truncate text-sm font-semibold text-slate-700">{{ c.course }}</span>
                    {% if c.full_paid %}
                    <span class="shrink-0 text-xs font-bold text-teal-600">Paid ✓</span>
                    {% endif %}
                </div>
                <div class="mt-2 flex justify-between text-xs text-slate-500">
                    <span>Paid: <b class="text-teal-600">৳ {{ c.paid|number_format(0) }}</b></span>
                    <span>Due: <b class="{{ c.due > 0 ? 'text-rose-600' : 'text-teal-600' }}">৳ {{ c.due|number_format(0) }}</b></span>
                </div>
                {% if c.deadline and c.due > 0 %}
                <div class="mt-2 text-xs {{ c.deadline_passed ? 'font-semibold text-rose-600' : 'text-slate-400' }}">
                    Deadline: {{ c.deadline }}{% if c.deadline_passed %} ⚠ passed{% endif %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

{# ============ Notifications ============ #}
<div class="reveal bg-white rounded-2xl p-5 ring-1 ring-slate-200/70 sm:p-6" id="notifications">
    <h3 class="mb-4 flex items-center gap-2 font-bold text-slate-900">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-rose-50 text-rose-500">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/></svg>
        </span>
        Notifications
    </h3>
    {% if data.notifications is empty %}
    <p class="text-sm text-slate-500">No notifications yet.</p>
    {% else %}
    <div class="divide-y divide-slate-50">
        {% for n in data.notifications %}
        <div class="flex items-start gap-3 py-3 {{ n.is_read ? 'opacity-60' : '' }}">
            <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full {{ n.is_read ? 'bg-slate-200' : 'bg-rose-500' }}"></span>
            <div class="min-w-0 flex-1">
                <div class="text-sm font-semibold text-slate-800">{{ n.title }}</div>
                <div class="mt-0.5 text-xs text-slate-500">{{ n.body }}</div>
            </div>
            <span class="ml-auto shrink-0 font-mono text-[11px] text-slate-400">{{ n.created_at }}</span>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}
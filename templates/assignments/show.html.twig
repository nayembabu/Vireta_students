{% extends 'app/layout.html.twig' %}

{% block page_title %}{{ assignment.title }}{% endblock %}
{% block page_heading %}Assignment{% endblock %}

{% block content %}
<a href="{{ base_path }}/assignments"
   class="inline-flex items-center gap-1.5 text-sm font-medium text-teal-700 hover:text-teal-600">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
    Back to assignments
</a>

<div class="mt-4 rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
    <div class="mb-2 flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wide text-teal-600">{{ assignment.course_title }}</span>
        <span class="text-slate-300">•</span>
        <span class="text-xs text-slate-400">Max score {{ assignment.max_score }}</span>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <h1 class="text-xl font-extrabold text-slate-900 sm:text-2xl">{{ assignment.title }}</h1>
        <span class="inline-block shrink-0 rounded-full px-3 py-1 text-xs font-bold
            {{ assignment.state.key == 'missed' ? 'bg-rose-100 text-rose-600'
             : assignment.state.key in ['open', 'submitted'] ? 'bg-amber-100 text-amber-700'
             : assignment.state.key == 'graded' ? 'bg-sky-100 text-sky-700'
             : 'bg-slate-100 text-slate-600' }}">
            {{ assignment.state.label }}
        </span>
    </div>
    <p class="mt-3 whitespace-pre-line text-sm text-slate-500">{{ assignment.description }}</p>
    <p class="mt-3 text-xs text-slate-400">Due: <span class="font-semibold text-slate-500">{{ assignment.due_date|date('d M Y, h:i A') }}</span></p>
</div>

{% if assignment.latest and assignment.latest.score is not null %}
<div class="mt-6 rounded-2xl bg-sky-50 p-5 ring-1 ring-sky-200">
    <div class="flex items-center justify-between">
        <h2 class="font-bold text-sky-900">Grading result</h2>
        <div class="text-2xl font-extrabold text-sky-700">{{ assignment.latest.score }}/{{ assignment.max_score }}</div>
    </div>
    {% if assignment.latest.feedback %}
    <p class="mt-3 text-sm text-sky-800">{{ assignment.latest.feedback }}</p>
    {% endif %}
</div>
{% endif %}

{% if assignment.state.can_submit %}
<div class="mt-6 rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
    <h2 class="mb-1 font-bold text-slate-900">
        {% if assignment.latest %}Submit new version{% else %}Submit{% endif %}
    </h2>
    <p class="mb-4 text-sm text-slate-500">Provide text or a file — at least one is required (file: pdf/doc/docx/zip/jpg/png, max 10MB).</p>

    <form method="post" action="{{ base_path }}/assignments/{{ assignment.id }}/submit" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <div class="mb-4">
            <label class="mb-1.5 block text-sm font-semibold text-slate-700">Answer (text)</label>
            <textarea name="submission_text" rows="6"
                      class="w-full rounded-xl border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 {{ errors.submission_text ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">{{ old.submission_text }}</textarea>
            {% if errors.submission_text %}<p class="mt-1 text-xs text-rose-600">{{ errors.submission_text }}</p>{% endif %}
        </div>
        <div>
            <label class="mb-1.5 block text-sm font-semibold text-slate-700">File</label>
            <input type="file" name="submission_file"
                   class="block w-full text-xs text-slate-500 file:mr-3 file:cursor-pointer file:rounded-lg file:border-0 file:bg-slate-900 file:px-3 file:py-2 file:text-xs file:font-semibold file:text-white hover:file:bg-teal-600">
            {% if errors.submission_file %}<p class="mt-1 text-xs text-rose-600">{{ errors.submission_file }}</p>{% endif %}
        </div>
        <div class="mt-5 flex justify-end">
            <button type="submit" class="rounded-xl bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-900/10 transition hover:bg-teal-600">
                {% if assignment.latest %}Update version{% else %}Submit{% endif %}
            </button>
        </div>
    </form>
</div>
{% endif %}

<div class="mt-6 rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
    <h2 class="mb-4 font-bold text-slate-900">My submissions (version history)</h2>

    {% if assignment.history is empty %}
    <p class="text-sm text-slate-500">You haven't submitted anything yet.</p>
    {% else %}
    <div class="space-y-4">
        {% for h in assignment.history %}
        <div class="rounded-xl border p-4 {{ loop.first ? 'border-teal-200 bg-teal-50/50' : 'border-slate-100' }}">
            <div class="flex flex-wrap items-center gap-2">
                <span class="font-mono text-sm font-bold text-slate-800">v{{ h.version }}</span>
                <span class="font-semibold text-slate-700">— Version {{ h.version }}</span>
                {% if loop.first %}<span class="rounded-full bg-teal-100 px-2 py-0.5 text-xs font-semibold text-teal-700">Latest</span>{% endif %}
                <span class="ml-auto text-xs text-slate-400">{{ h.submitted_at ? h.submitted_at|date('d M Y, h:i A') : '' }}</span>
            </div>
            {% if h.submission_text %}
            <p class="mt-2 whitespace-pre-line text-sm text-slate-700">{{ h.submission_text }}</p>
            {% endif %}
            {% if h.file_path %}
            <a href="{{ upload(h.file_path) }}" target="_blank"
               class="mt-2 inline-block text-sm font-semibold text-teal-700 hover:text-teal-600">View attached file</a>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}
{% extends 'app/layout.html.twig' %}

{% block page_title %}{{ assignment.title }}{% endblock %}

{% block content %}
<a href="{{ base_path }}/assignments"
   class="text-sm font-medium text-indigo-600 hover:text-indigo-700">← Back to assignments</a>

<div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6 mt-4">
    <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="text-xs font-semibold uppercase tracking-wide text-indigo-500">{{ assignment.course_title }}</span>
        <span class="text-slate-300">•</span>
        <span class="text-xs text-slate-400">Max score {{ assignment.max_score }}</span>
    </div>
    <div class="flex items-start justify-between gap-4">
        <h1 class="text-2xl font-extrabold text-slate-900">{{ assignment.title }}</h1>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold shrink-0
            {{ assignment.state.key == 'missed' ? 'bg-rose-100 text-rose-600'
             : assignment.state.key in ['open', 'submitted'] ? 'bg-amber-100 text-amber-700'
             : assignment.state.key == 'graded' ? 'bg-sky-100 text-sky-700'
             : 'bg-slate-100 text-slate-600' }}">
            {{ assignment.state.label }}
        </span>
    </div>
    <p class="text-slate-500 text-sm mt-3 whitespace-pre-line">{{ assignment.description }}</p>
    <p class="text-xs text-slate-400 mt-3">Due: {{ assignment.due_date|date('d M Y, h:i A') }}</p>
</div>

{% if assignment.latest and assignment.latest.score is not null %}
<div class="bg-sky-50 ring-1 ring-sky-200 rounded-2xl p-5 mt-6">
    <div class="flex items-center justify-between">
        <h2 class="font-bold text-sky-900">Grading result</h2>
        <div class="text-2xl font-extrabold text-sky-700">{{ assignment.latest.score }}/{{ assignment.max_score }}</div>
    </div>
    {% if assignment.latest.feedback %}
    <p class="text-sm text-sky-800 mt-3">{{ assignment.latest.feedback }}</p>
    {% endif %}
</div>
{% endif %}

{% if assignment.state.can_submit %}
<div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6 mt-6">
    <h2 class="font-bold text-slate-900 mb-1">
        {% if assignment.latest %}Submit new version{% else %}Submit{% endif %}
    </h2>
    <p class="text-sm text-slate-500 mb-4">Provide text or a file — at least one is required (file: pdf/doc/docx/zip/jpg/png, max 10MB).</p>

    <form method="post" action="{{ base_path }}/assignments/{{ assignment.id }}/submit" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <div class="mb-4">
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Answer (text)</label>
            <textarea name="submission_text" rows="6"
                      class="w-full rounded-xl border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.submission_text ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">{{ old.submission_text }}</textarea>
            {% if errors.submission_text %}<p class="text-xs text-rose-600 mt-1">{{ errors.submission_text }}</p>{% endif %}
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">File</label>
            <input type="file" name="submission_file"
                   class="block w-full text-xs text-slate-500 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-900 file:text-white file:text-xs file:font-semibold file:px-3 file:py-2 file:cursor-pointer">
            {% if errors.submission_file %}<p class="text-xs text-rose-600 mt-1">{{ errors.submission_file }}</p>{% endif %}
        </div>
        <div class="mt-5 flex justify-end">
            <button type="submit" class="rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-6 py-3 transition shadow-lg shadow-indigo-200">
                {% if assignment.latest %}Update version{% else %}Submit{% endif %}
            </button>
        </div>
    </form>
</div>
{% endif %}

<div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6 mt-6">
    <h2 class="font-bold text-slate-900 mb-4">My submissions (version history)</h2>

    {% if assignment.history is empty %}
    <p class="text-sm text-slate-500">You haven't submitted anything yet.</p>
    {% else %}
    <div class="space-y-4">
        {% for h in assignment.history %}
        <div class="rounded-xl border {{ loop.first ? 'border-indigo-200 bg-indigo-50/50' : 'border-slate-100' }} p-4">
            <div class="flex flex-wrap items-center gap-2">
                <span class="font-bold text-slate-800">Version {{ h.version }}</span>
                {% if loop.first %}<span class="text-xs font-semibold text-indigo-600 bg-indigo-100 px-2 py-0.5 rounded-full">Latest</span>{% endif %}
                <span class="text-xs text-slate-400 ml-auto">{{ h.submitted_at ? h.submitted_at|date('d M Y, h:i A') : '' }}</span>
            </div>
            {% if h.submission_text %}
            <p class="text-sm text-slate-700 mt-2 whitespace-pre-line">{{ h.submission_text }}</p>
            {% endif %}
            {% if h.file_path %}
            <a href="{{ upload(h.file_path) }}" target="_blank"
               class="inline-block mt-2 text-sm font-semibold text-indigo-600 hover:text-indigo-700">View attached file</a>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}
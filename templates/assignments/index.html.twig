{% extends 'app/layout.html.twig' %}

{% block page_title %}Assignments{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-extrabold text-slate-900">Assignments</h1>
        <p class="text-sm text-slate-500 mt-1">List of assignments for your enrolled courses.</p>
    </div>
</div>

{% if items is empty %}
<div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-12 text-center">
    <div class="text-3xl mb-3 text-slate-300">(</div>
    <h2 class="text-lg font-bold text-slate-800">No assignments yet</h2>
    <p class="text-sm text-slate-500 mt-1">No assignments have been added to your courses yet.</p>
</div>
{% else %}
<div class="space-y-4">
    {% for item in items %}
    <div class="rounded-2xl ring-1 shadow-sm p-5 transition {{ item.state == 'missed'
            ? 'bg-rose-50 ring-rose-200'
            : 'bg-white ring-slate-100' }}">
        <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class="text-xs font-semibold uppercase tracking-wide {{ item.state == 'missed' ? 'text-rose-500' : 'text-indigo-500' }}">
                {{ item.course }}
            </span>
            <span class="text-slate-300">•</span>
            <span class="text-xs text-slate-400">Max score {{ item.max_score }}</span>
        </div>

        <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
                <h2 class="text-lg font-bold text-slate-900">{{ item.title }}</h2>
                <p class="text-sm text-slate-500 mt-0.5 line-clamp-2">{{ item.description }}</p>
                <p class="text-xs text-slate-400 mt-2">Due: {{ item.due_date|date('d M Y, h:i A') }}</p>
            </div>
            <div class="shrink-0 text-right space-y-2">
                <span class="inline-block px-3 py-1 rounded-full text-xs font-bold
                    {{ item.state == 'missed' ? 'bg-rose-100 text-rose-600'
                     : item.state == 'open' ? 'bg-amber-100 text-amber-700'
                     : item.state == 'graded' ? 'bg-sky-100 text-sky-700'
                     : 'bg-emerald-100 text-emerald-700' }}">
                    {{ item.state_label }}
                </span>
                {% if item.version_count > 0 %}
                <div class="text-xs text-slate-400">{{ item.version_count }} version{% if item.latest_score %} • Score {{ item.latest_score }}/{{ item.max_score }}{% endif %}</div>
                {% endif %}
            </div>
        </div>

        <div class="mt-4 flex items-center gap-3">
            {% if item.can_submit %}
            <a href="{{ base_path }}/assignments/{{ item.id }}"
               class="rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2 transition">
                {{ item.version_count > 0 ? 'Edit' : 'Submit' }}
            </a>
            {% endif %}
            <a href="{{ base_path }}/assignments/{{ item.id }}"
               class="rounded-xl border border-slate-200 hover:border-indigo-300 hover:text-indigo-600 text-slate-700 text-sm font-semibold px-4 py-2 transition">
                Details
            </a>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
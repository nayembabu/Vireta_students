{% extends 'app/layout.html.twig' %}

{% block page_title %}Assignments{% endblock %}
{% block page_heading %}Assignments{% endblock %}

{% block content %}
<p class="mb-6 text-sm text-slate-500">Assignments for your enrolled courses.</p>

{% if items is empty %}
<div class="rounded-2xl bg-white p-12 text-center ring-1 ring-slate-200/70">
    <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
        <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
    </div>
    <h2 class="text-lg font-bold text-slate-800">No assignments yet</h2>
    <p class="mt-1 text-sm text-slate-500">No assignments have been added to your courses yet.</p>
</div>
{% else %}
<div class="space-y-4">
    {% for item in items %}
    <div class="rounded-2xl ring-1 p-5 transition {{ item.state == 'missed' ? 'bg-rose-50/70 ring-rose-200' : 'bg-white ring-slate-200/70 hover:ring-teal-300' }}">
        <div class="mb-2 flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wide {{ item.state == 'missed' ? 'text-rose-500' : 'text-teal-600' }}">
                {{ item.course }}
            </span>
            <span class="text-slate-300">•</span>
            <span class="text-xs text-slate-400">Max score {{ item.max_score }}</span>
        </div>

        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
                <h2 class="text-lg font-bold text-slate-900">{{ item.title }}</h2>
                <p class="mt-0.5 line-clamp-2 text-sm text-slate-500">{{ item.description }}</p>
                <p class="mt-2 text-xs text-slate-400">Due: <span class="font-semibold text-slate-500">{{ item.due_date|date('d M Y, h:i A') }}</span></p>
            </div>
            <div class="shrink-0 space-y-2 sm:text-right">
                <span class="inline-block rounded-full px-3 py-1 text-xs font-bold
                    {{ item.state == 'missed' ? 'bg-rose-100 text-rose-600'
                     : item.state == 'open' ? 'bg-amber-100 text-amber-700'
                     : item.state == 'graded' ? 'bg-sky-100 text-sky-700'
                     : 'bg-teal-100 text-teal-700' }}">
                    {{ item.state_label }}
                </span>
                {% if item.version_count > 0 %}
                <div class="text-xs text-slate-400">{{ item.version_count }} version{% if item.latest_score %} • Score {{ item.latest_score }}/{{ item.max_score }}{% endif %}</div>
                {% endif %}
            </div>
        </div>

        <div class="mt-4 flex items-center gap-3">
            {% if item.can_submit %}
            <a href="{{ base_path }}/assignments/{{ item.id }}"
               class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-600">
                {{ item.version_count > 0 ? 'Edit' : 'Submit' }}
            </a>
            {% endif %}
            <a href="{{ base_path }}/assignments/{{ item.id }}"
               class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-teal-300 hover:text-teal-700">
                Details
            </a>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
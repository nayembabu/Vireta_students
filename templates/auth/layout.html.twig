{% extends 'base.html.twig' %}

{% block title %}{% block auth_title %}{% endblock %} - {{ app_name }}{% endblock %}

{% block body %}
<div class="relative flex min-h-screen flex-col overflow-hidden bg-[#faf9f6]">
    {# ================= Colorful aurora background ================= #}
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="animate-blob absolute -top-32 -left-32 h-[26rem] w-[26rem] rounded-full bg-indigo-300/50 blur-3xl"></div>
        <div class="animate-blob animation-delay-2000 absolute top-1/3 -right-28 h-[24rem] w-[24rem] rounded-full bg-fuchsia-300/45 blur-3xl"></div>
        <div class="animate-blob animation-delay-4000 absolute bottom-0 left-1/4 h-[22rem] w-[22rem] rounded-full bg-cyan-300/40 blur-3xl"></div>
        <div class="animate-blob animation-delay-6000 absolute -bottom-24 right-1/3 h-80 w-80 rounded-full bg-amber-200/60 blur-3xl"></div>
        <div class="bg-dots absolute inset-0 opacity-50"></div>
        {# spinning conic halo #}
        <div class="absolute left-1/2 top-[-14rem] h-[34rem] w-[34rem] -translate-x-1/2 rounded-full opacity-25 blur-3xl"
             style="background: conic-gradient(from 0deg, #6366f1, #d946ef, #06b6d4, #f59e0b, #6366f1); animation: spin-slow 18s linear infinite;"></div>
    </div>

    {# floating sparkles #}
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <span class="animate-float absolute left-[8%] top-[18%] text-2xl text-fuchsia-400/70">✦</span>
        <span class="animate-float absolute right-[10%] top-[24%] text-xl text-indigo-400/70" style="animation-delay: 1.4s;">✦</span>
        <span class="animate-float absolute bottom-[22%] left-[14%] text-lg text-amber-400/70" style="animation-delay: 2.2s;">✦</span>
        <span class="animate-float absolute bottom-[16%] right-[16%] text-2xl text-cyan-400/70" style="animation-delay: 0.8s;">✦</span>
    </div>

    <div class="relative flex flex-1 items-center justify-center px-4 py-5">
        <div class="w-full max-w-md">
            {# ================= Brand header ================= #}
            <div class="mb-4 text-center">
                <div class="relative mx-auto inline-block">
                    <div class="absolute -inset-3 rounded-3xl bg-gradient-to-tr from-indigo-400 via-fuchsia-400 to-amber-300 opacity-60 blur-xl" aria-hidden="true"></div>
                    <img src="{{ upload('logo/logo2.png') }}" alt="{{ app_name }}"
                         class="relative h-14 w-14 rounded-2xl bg-white shadow-lg ring-1 ring-slate-200">
                </div>
                <h1 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900">
                    {% block auth_heading %}{% endblock %}
                </h1>
                <p class="mt-1 text-sm text-slate-500">{% block auth_subheading %}{% endblock %}</p>
            </div>

            {% include 'partials/_flash.html.twig' %}

            {# ================= Glass card with gradient border ================= #}
            <div class="rounded-2xl bg-gradient-to-br from-indigo-500 via-fuchsia-500 to-amber-400 p-[1.5px] shadow-2xl shadow-indigo-500/25">
                <div class="rounded-2xl bg-white/85 p-4 backdrop-blur-xl sm:p-6">
                    {% block auth_content %}{% endblock %}
                </div>
            </div>

            <div class="mt-4 text-center">
                <a href="{{ base_path }}/" class="inline-flex items-center gap-1.5 text-sm font-medium text-indigo-600 transition hover:text-indigo-700">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
                    Back to home
                </a>
            </div>
        </div>
    </div>

    {# bottom gradient bar #}
    <div class="h-1.5 w-full bg-gradient-to-r from-indigo-500 via-fuchsia-500 to-amber-400"></div>
</div>
{% endblock %}
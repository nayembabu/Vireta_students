{% extends 'auth/layout.html.twig' %}

{% block auth_title %}Create Account{% endblock %}
{% block auth_heading %}Create Your Account{% endblock %}
{% block auth_subheading %}{{ student.name }} — provide your login details{% endblock %}

{% block auth_content %}
<form method="post" action="{{ base_path }}/register/account" class="space-y-4">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">

    <div class="rounded-xl bg-indigo-50 ring-1 ring-indigo-100 px-4 py-3 text-sm text-slate-700">
        <span class="font-semibold text-indigo-700">Registration no:</span> {{ student.educational_registration_no }}
        <span class="mx-2 text-slate-300">|</span>
        <span class="font-semibold text-indigo-700">Mobile:</span> {{ student.phone_no }}
    </div>

    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">
            Email address (login ID)
            <span class="text-rose-500">*</span>
        </label>
        <input type="email" name="email" value="{{ old.email|default('') }}" placeholder="you@example.com"
               class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.email ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
        {% if errors.email %}<p class="text-xs text-rose-600 mt-1">{{ errors.email }}</p>{% endif %}
    </div>

    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">
            Password
            <span class="text-rose-500">*</span>
        </label>
        <input type="password" name="password" placeholder="At least 8 characters"
               class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.password ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
        {% if errors.password %}<p class="text-xs text-rose-600 mt-1">{{ errors.password }}</p>{% endif %}
    </div>

    <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">
            Confirm password
            <span class="text-rose-500">*</span>
        </label>
        <input type="password" name="password_confirmation" placeholder="Re-enter password"
               class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.password_confirmation ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
        {% if errors.password_confirmation %}<p class="text-xs text-rose-600 mt-1">{{ errors.password_confirmation }}</p>{% endif %}
    </div>

    <button type="submit"
            class="w-full rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 text-sm transition shadow-lg shadow-emerald-200">
        Create Account
    </button>
</form>
{% endblock %}

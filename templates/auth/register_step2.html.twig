{% extends 'auth/layout.html.twig' %}

{% block auth_title %}Personal Information{% endblock %}
{% block auth_heading %}Personal Information{% endblock %}
{% block auth_subheading %}Registration no: {{ student.educational_registration_no }} · Batch: {{ batch_name ?? '—' }}{% endblock %}

{% block auth_content %}
<form method="post" action="{{ base_path }}/register/details" class="space-y-4">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Full name <span class="text-rose-500">*</span></label>
            <input type="text" name="name" value="{{ old.name }}" placeholder="Your full name"
                   class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.name ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
            {% if errors.name %}<p class="text-xs text-rose-600 mt-1">{{ errors.name }}</p>{% endif %}
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Father's name <span class="text-rose-500">*</span></label>
            <input type="text" name="father_name" value="{{ old.father_name }}" placeholder="Father's full name"
                   class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.father_name ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
            {% if errors.father_name %}<p class="text-xs text-rose-600 mt-1">{{ errors.father_name }}</p>{% endif %}
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Mother's name <span class="text-rose-500">*</span></label>
            <input type="text" name="mother_name" value="{{ old.mother_name }}" placeholder="Mother's full name"
                   class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.mother_name ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
            {% if errors.mother_name %}<p class="text-xs text-rose-600 mt-1">{{ errors.mother_name }}</p>{% endif %}
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Date of birth <span class="text-rose-500">*</span></label>
            <input type="date" name="date_of_birth" value="{{ old.date_of_birth }}"
                   class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.date_of_birth ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
            {% if errors.date_of_birth %}<p class="text-xs text-rose-600 mt-1">{{ errors.date_of_birth }}</p>{% endif %}
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Gender <span class="text-rose-500">*</span></label>
            <select name="gender"
                    class="w-full rounded-xl border px-4 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.gender ? 'border-rose-300' : 'border-slate-200' }}">
                <option value="">— Select —</option>
                <option value="male" {{ old.gender == 'male' ? 'selected' }}>Male</option>
                <option value="female" {{ old.gender == 'female' ? 'selected' }}>Female</option>
                <option value="other" {{ old.gender == 'other' ? 'selected' }}>Other</option>
            </select>
            {% if errors.gender %}<p class="text-xs text-rose-600 mt-1">{{ errors.gender }}</p>{% endif %}
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Blood group</label>
            <input type="text" name="blood_group" value="{{ old.blood_group }}" placeholder="e.g. O+" maxlength="4"
                   class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 border-slate-200">
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">SSC Roll <span class="text-rose-500">*</span></label>
            <input type="text" name="ssc_roll" value="{{ old.ssc_roll }}" placeholder="SSC roll number"
                   class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.ssc_roll ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
            {% if errors.ssc_roll %}<p class="text-xs text-rose-600 mt-1">{{ errors.ssc_roll }}</p>{% endif %}
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">SSC Registration <span class="text-rose-500">*</span></label>
            <input type="text" name="ssc_registration" value="{{ old.ssc_registration }}" placeholder="SSC registration number"
                   class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.ssc_registration ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
            {% if errors.ssc_registration %}<p class="text-xs text-rose-600 mt-1">{{ errors.ssc_registration }}</p>{% endif %}
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">WhatsApp number</label>
            <input type="text" name="whatsapp_number" value="{{ old.whatsapp_number }}" placeholder="01XXXXXXXXX"
                   class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 border-slate-200">
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Emergency contact number</label>
            <input type="text" name="emergency_phone" value="{{ old.emergency_phone }}" placeholder="01XXXXXXXXX"
                   class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 border-slate-200">
        </div>
        <div class="sm:col-span-2">
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">NID / Birth certificate number</label>
            <input type="text" name="nid_birth_no" value="{{ old.nid_birth_no }}" placeholder="NID or birth certificate number"
                   class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 border-slate-200">
        </div>
        <div class="sm:col-span-2">
            <label class="block text-sm font-semibold text-slate-700 mb-1.5">Address</label>
            <textarea name="address" rows="3" placeholder="Current address"
                      class="w-full rounded-xl border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 border-slate-200">{{ old.address }}</textarea>
        </div>
    </div>

    <button type="submit"
            class="w-full rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 text-sm transition shadow-lg shadow-indigo-200">
        Save & Continue →
    </button>
</form>
{% endblock %}

{% extends 'app/layout.html.twig' %}

{% block page_title %}Not Found{% endblock %}
{% block page_heading %}Not Found{% endblock %}

{% block content %}
<div class="mx-auto max-w-md py-16 text-center">
    <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-900 text-3xl font-extrabold text-teal-400">?</div>
    <h1 class="text-2xl font-extrabold text-slate-900">Page not found</h1>
    <p class="mt-2 text-slate-500">{{ message }}</p>
    <a href="{{ base_path }}/"
       class="mt-6 inline-block rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-600">
        Back to dashboard
    </a>
</div>
{% endblock %}
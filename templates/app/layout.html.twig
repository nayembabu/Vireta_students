{% extends 'base.html.twig' %}

{% block title %}{% block page_title %}{% endblock %} - {{ app_name }}{% endblock %}

{% block body %}

{# ================= Topbar ================= #}
<nav id="site-nav" class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between gap-3">

            {# Brand #}
            <a href="{{ base_path }}/" class="flex shrink-0 items-center gap-2.5">
                <img src="{{ upload('logo/logo2.png') }}" alt="{{ app_name }}" class="h-9 w-9 rounded-xl ring-2 ring-teal-400/40">
                <span class="hidden text-sm font-extrabold tracking-tight text-slate-900 sm:block">Vireta<span class="text-teal-600">Dev</span></span>
            </a>

            {# Desktop menu #}
            <div class="hidden items-center gap-1 text-sm font-medium md:flex">
                <a href="{{ base_path }}/" class="nav-link rounded-lg px-3 py-2 text-slate-600 transition hover:bg-teal-50 hover:text-teal-700">Dashboard</a>
                <a href="{{ base_path }}/profile" class="nav-link rounded-lg px-3 py-2 text-slate-600 transition hover:bg-teal-50 hover:text-teal-700">Profile</a>
                <a href="{{ base_path }}/routine" class="nav-link rounded-lg px-3 py-2 text-slate-600 transition hover:bg-teal-50 hover:text-teal-700">Routine</a>
                <a href="{{ base_path }}/attendance" class="nav-link rounded-lg px-3 py-2 text-slate-600 transition hover:bg-teal-50 hover:text-teal-700">Attendance</a>
                <a href="{{ base_path }}/assignments" class="nav-link rounded-lg px-3 py-2 text-slate-600 transition hover:bg-teal-50 hover:text-teal-700">Assignments</a>
                <a href="{{ base_path }}/fees" class="nav-link rounded-lg px-3 py-2 text-slate-600 transition hover:bg-teal-50 hover:text-teal-700">Fees</a>
                {% if auth_user.role in ['admin', 'trainer', 'cashier'] %}
                <a href="{{ base_path }}/admin" class="nav-link rounded-lg px-3 py-2 text-slate-600 transition hover:bg-teal-50 hover:text-teal-700">⚙️ Admin</a>
                {% endif %}
            </div>

            {# Right side: avatar + logout (desktop), burger (mobile) #}
            <div class="flex items-center gap-2">
                <div class="hidden items-center gap-2 md:flex">
                    <img src="{{ auth_user.pro_pic ? upload(auth_user.pro_pic) : upload('logo/logo2.png') }}"
                         alt="avatar" class="h-8 w-8 rounded-full object-cover ring-2 ring-teal-400/40">
                    <div class="leading-tight">
                        <div class="max-w-[10rem] truncate text-sm font-semibold text-slate-800">{{ auth_user.name }}</div>
                        <div class="text-xs text-teal-600">{{ auth_user.role }}</div>
                    </div>
                </div>
                <form method="post" action="{{ base_path }}/logout" class="hidden md:block">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <button type="submit" title="Logout"
                            class="rounded-lg p-2 text-slate-400 transition hover:bg-rose-50 hover:text-rose-500">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-7.5A2.25 2.25 0 003.75 5.25v13.5A2.25 2.25 0 006 21h7.5a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H9"/></svg>
                    </button>
                </form>

                <button id="nav-toggle" class="rounded-lg p-2 text-slate-600 transition hover:bg-slate-100 md:hidden" aria-label="Toggle menu" aria-controls="nav-menu">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
                </button>
            </div>
        </div>
    </div>

    {# Mobile dropdown menu #}
    <div id="nav-menu" class="hidden flex-col border-t border-slate-200 bg-white/95 px-4 pb-4 pt-2 backdrop-blur-xl md:hidden">
        <a href="{{ base_path }}/" class="nav-link block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-teal-50 hover:text-teal-700">🏠 Dashboard</a>
        <a href="{{ base_path }}/profile" class="nav-link block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-teal-50 hover:text-teal-700">👤 Profile</a>
        <a href="{{ base_path }}/routine" class="nav-link block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-teal-50 hover:text-teal-700">📅 Routine</a>
        <a href="{{ base_path }}/attendance" class="nav-link block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-teal-50 hover:text-teal-700">✅ Attendance</a>
        <a href="{{ base_path }}/assignments" class="nav-link block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-teal-50 hover:text-teal-700">📝 Assignments</a>
        <a href="{{ base_path }}/fees" class="nav-link block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-teal-50 hover:text-teal-700">💳 Fees</a>
        {% if auth_user.role in ['admin', 'trainer', 'cashier'] %}
        <a href="{{ base_path }}/admin" class="nav-link block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-teal-50 hover:text-teal-700">⚙️ Admin panel</a>
        {% endif %}
        <div class="mt-2 border-t border-slate-100 pt-2">
            <div class="flex items-center gap-2 px-3 py-2">
                <img src="{{ auth_user.pro_pic ? upload(auth_user.pro_pic) : upload('logo/logo2.png') }}"
                     alt="avatar" class="h-8 w-8 rounded-full object-cover ring-2 ring-teal-400/40">
                <div class="min-w-0 leading-tight">
                    <div class="truncate text-sm font-semibold text-slate-800">{{ auth_user.name }}</div>
                    <div class="text-xs text-teal-600">{{ auth_user.role }}</div>
                </div>
            </div>
            <form method="post" action="{{ base_path }}/logout">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <button type="submit" class="w-full rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-rose-500 hover:bg-rose-50">Logout</button>
            </form>
        </div>
    </div>
</nav>

{# ================= Content ================= #}
<main class="mx-auto w-full max-w-6xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
    {% include 'partials/_flash.html.twig' %}
    {% block content %}{% endblock %}
</main>

<footer class="border-t border-slate-200/80 px-4 py-5 text-center text-xs text-slate-400">
    © {{ "now"|date("Y") }} {{ app_name }} · v{{ app_version }}
</footer>
{% endblock %}
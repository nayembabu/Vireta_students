{% extends 'base.html.twig' %}

{% block title %}{{ app_name }} • Training Center{% endblock %}

{% block body %}
{# ====================================================================== #
   TOP BAR (light)
# ====================================================================== #}
<div class="bg-slate-900 text-slate-300">
    <div class="mx-auto flex h-10 max-w-7xl items-center justify-between px-4 text-xs sm:px-6 lg:px-8">
        <div class="flex items-center gap-5">
            <span class="hidden items-center gap-1.5 sm:flex">
                <svg class="h-3.5 w-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 006.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 011.767-1.052l3.223.716A1.5 1.5 0 0118 15.352V16.5a1.5 1.5 0 01-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 012.43 8.326 13.019 13.019 0 012 5V3.5z"/></svg>
                +880 1700-000000
            </span>
            <span class="hidden items-center gap-1.5 md:flex">
                <svg class="h-3.5 w-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"/><path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"/></svg>
                hello@viretadev.com
            </span>
        </div>
        <p class="flex items-center gap-2 font-semibold text-white">
            <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            Admission Open — Batch 2026
        </p>
    </div>
</div>

{# ====================================================================== #
   NAVBAR (light)
# ====================================================================== #}
<nav id="site-nav" class="sticky top-0 z-50 border-b border-slate-200/70 bg-[#faf9f6]/85 backdrop-blur-md">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
            <a href="{{ url_for('home') }}" class="flex items-center gap-2.5">
                <img src="{{ upload('logo/logo2.png') }}" alt="{{ app_name }}" class="h-10 w-auto">
                <span class="font-display text-lg font-bold tracking-tight text-slate-900">Vireta<span class="text-gradient">Dev</span></span>
            </a>

            <div class="hidden items-center gap-7 md:flex" id="nav-links">
                <a href="{{ url_for('home') }}" class="text-sm font-semibold text-indigo-600">Home</a>
                <a href="#courses" class="text-sm font-medium text-slate-600 transition hover:text-slate-900">Courses</a>
                <a href="#why" class="text-sm font-medium text-slate-600 transition hover:text-slate-900">Why us</a>
                <a href="#steps" class="text-sm font-medium text-slate-600 transition hover:text-slate-900">Admission</a>
                <a href="#success" class="text-sm font-medium text-slate-600 transition hover:text-slate-900">Success</a>
            </div>

            <div class="hidden items-center gap-3 md:flex">
                <a href="{{ url_for('login') }}" class="rounded-lg px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100 hover:text-slate-900">
                    Sign in
                </a>
                <a href="{{ url_for('register') }}" class="btn-shine rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-indigo-500/25 transition hover:bg-indigo-700">
                    Admission Open
                </a>
            </div>

            <button id="nav-toggle" class="rounded-lg p-2 text-slate-600 hover:bg-slate-100 md:hidden" aria-label="Toggle menu">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
        </div>
    </div>
    <div id="nav-menu" class="hidden border-t border-slate-200 bg-[#faf9f6]/95 px-4 pb-4 pt-2 backdrop-blur-xl md:hidden">
        <a href="{{ url_for('home') }}" class="block rounded-lg px-3 py-2 text-sm font-semibold text-indigo-600 hover:bg-indigo-50">Home</a>
        <a href="#courses" class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">Courses</a>
        <a href="#why" class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">Why us</a>
        <a href="#steps" class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">Admission</a>
        <a href="#success" class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">Success</a>
        <div class="mt-3 flex gap-3">
            <a href="{{ url_for('login') }}" class="flex-1 rounded-lg border border-slate-300 px-4 py-2 text-center text-sm font-semibold text-slate-700">Sign in</a>
            <a href="{{ url_for('register') }}" class="flex-1 rounded-lg bg-indigo-600 px-4 py-2 text-center text-sm font-semibold text-white">Admission Open</a>
        </div>
    </div>
</nav>

{# ====================================================================== #
   HERO (light, warm)
# ====================================================================== #}
<section class="relative overflow-hidden pt-16 pb-20 sm:pt-24 sm:pb-28">
    {# soft background wash #}
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-32 -left-32 h-[30rem] w-[30rem] rounded-full bg-indigo-200/40 blur-3xl"></div>
        <div class="absolute top-1/4 -right-32 h-[26rem] w-[26rem] rounded-full bg-amber-200/40 blur-3xl"></div>
        <div class="bg-dots absolute inset-0 opacity-60"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
            {# ---- Left: copy ---- #}
            <div class="text-center lg:text-left">
                <div class="reveal inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white px-4 py-1.5 text-sm font-semibold text-indigo-700 shadow-sm">
                    <svg class="h-4 w-4 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z" clip-rule="evenodd"/></svg>
                    Govt. approved training center
                </div>

                <h1 class="reveal reveal-delay-1 mt-6 font-display text-[2.6rem] font-bold leading-[1.08] tracking-tight text-slate-900 sm:text-6xl lg:text-[4.2rem]">
                    Shape your future with
                    <span class="relative inline-block">
                        <em class="text-gradient not-italic">hands-on</em>
                        <svg class="absolute -bottom-2 left-0 w-full text-amber-400" viewBox="0 0 220 12" fill="none" preserveAspectRatio="none" aria-hidden="true"><path d="M3 9C60 3 160 3 217 9" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg>
                    </span>
                    tech training
                </h1>

                <p class="reveal reveal-delay-2 mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate-600 lg:mx-0">
                    Learn from industry mentors, work on real projects, track your attendance and assignments —
                    everything in one modern training portal built for serious learners.
                </p>

                <div class="reveal reveal-delay-3 mt-9 flex flex-col items-center gap-4 sm:flex-row lg:justify-start sm:justify-center">
                    <a href="{{ url_for('register') }}" class="btn-shine group w-full rounded-xl bg-indigo-600 px-8 py-3.5 text-center text-base font-bold text-white shadow-xl shadow-indigo-500/30 transition hover:bg-indigo-700 sm:w-auto">
                        Enroll Now — It's Free
                        <svg class="ml-1.5 inline-block h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12l-7.5 7.5M21 12H3"/></svg>
                    </a>
                    <a href="#courses" class="w-full rounded-xl border border-slate-300 bg-white px-8 py-3.5 text-center text-base font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50 sm:w-auto">
                        Browse Courses
                    </a>
                </div>

                <div class="reveal reveal-delay-3 mt-10 flex items-center justify-center gap-4 lg:justify-start">
                    <div class="flex -space-x-2.5">
                        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 text-[11px] font-bold text-white ring-2 ring-[#faf9f6]">RS</div>
                        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-amber-500 to-orange-600 text-[11px] font-bold text-white ring-2 ring-[#faf9f6]">TM</div>
                        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 text-[11px] font-bold text-white ring-2 ring-[#faf9f6]">AK</div>
                        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-rose-500 to-pink-600 text-[11px] font-bold text-white ring-2 ring-[#faf9f6]">+9</div>
                    </div>
                    <p class="text-sm text-slate-500">
                        <span class="font-bold text-slate-900">150+ learners</span> trained · 4.9/5 rating
                    </p>
                </div>
            </div>

            {# ---- Right: course-card collage ---- #}
            <div class="reveal reveal-delay-2 relative mx-auto w-full max-w-md lg:max-w-none">
                <div class="absolute -inset-6 rounded-[2.5rem] bg-gradient-to-tr from-indigo-200/50 via-transparent to-amber-200/50 blur-2xl" aria-hidden="true"></div>

                {# main course card #}
                <div class="animate-float relative rounded-3xl border border-slate-200 bg-white p-6 shadow-2xl shadow-indigo-900/10">
                    <div class="flex items-start justify-between">
                        <div class="rounded-xl bg-indigo-50 p-2.5 text-indigo-600">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/></svg>
                        </div>
                        <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-600">Live · Batch 08</span>
                    </div>

                    <h3 class="mt-5 font-display text-xl font-bold text-slate-900">Full-Stack Web Development</h3>
                    <p class="mt-1.5 text-sm text-slate-500">PHP, Laravel & JavaScript — build real apps from scratch.</p>

                    <div class="mt-5 flex items-center gap-2 text-xs font-semibold text-slate-500">
                        <span class="rounded-lg bg-slate-100 px-2.5 py-1">12 weeks</span>
                        <span class="rounded-lg bg-slate-100 px-2.5 py-1">Beginner → Pro</span>
                        <span class="rounded-lg bg-slate-100 px-2.5 py-1">60+ lessons</span>
                    </div>

                    <div class="mt-5 flex items-center justify-between border-t border-dashed border-slate-200 pt-4">
                        <div class="flex items-center gap-1 text-sm">
                            <svg class="h-4 w-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z"/></svg>
                            <span class="font-bold text-slate-900">4.9</span>
                            <span class="text-slate-400">(128)</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
                            <span class="relative flex h-2 w-2">
                                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
                            </span>
                            <span
                                class="cursor-pointer"
                                hx-get="{{ url_for('ping') }}"
                                hx-swap="none"
                                hx-trigger="load, every 15s"
                            >Live session</span>
                        </div>
                    </div>
                </div>

                {# floating: mentor card #}
                <div class="animate-float-delay absolute -left-4 top-16 flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-xl shadow-indigo-900/10 sm:-left-10">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 text-sm font-bold text-white">M</div>
                    <div>
                        <p class="text-sm font-bold text-slate-900">Mentor Support</p>
                        <p class="text-xs text-slate-500">24/7 guidance</p>
                    </div>
                </div>

                {# floating: progress card #}
                <div class="animate-float absolute -right-3 bottom-14 w-44 rounded-2xl border border-slate-200 bg-white p-4 shadow-xl shadow-indigo-900/10 sm:-right-8" style="animation-delay: 2.2s;">
                    <p class="text-xs font-semibold text-slate-500">Attendance</p>
                    <p class="font-display text-2xl font-bold text-emerald-600">94%</p>
                    <div class="mt-2 h-1.5 rounded-full bg-slate-100">
                        <div class="bar-grow h-1.5 w-[94%] rounded-full bg-gradient-to-r from-emerald-500 to-teal-500"></div>
                    </div>
                </div>

                {# floating: certificate chip #}
                <div class="absolute -bottom-5 left-8 flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 shadow-lg shadow-indigo-900/10">
                    <svg class="h-4 w-4 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                    <p class="text-xs font-bold text-slate-900">Certificate included</p>
                </div>
            </div>
        </div>
    </div>
</section>

{# ====================================================================== #
   SKILLS MARQUEE (light)
# ====================================================================== #}
<div class="border-y border-slate-200 bg-white py-5">
    <div class="marquee relative overflow-hidden">
        <div class="marquee-track flex w-max items-center gap-10">
            {% for skill in ['PHP','Laravel','JavaScript','React','Python','MySQL','Git & GitHub','UI / UX','HTML & CSS','REST APIs'] %}
                <span class="flex items-center gap-2.5 text-sm font-bold uppercase tracking-wider text-slate-400">
                    <svg class="h-4 w-4 text-indigo-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                    {{ skill }}
                </span>
            {% endfor %}
            {% for skill in ['PHP','Laravel','JavaScript','React','Python','MySQL','Git & GitHub','UI / UX','HTML & CSS','REST APIs'] %}
                <span class="flex items-center gap-2.5 text-sm font-bold uppercase tracking-wider text-slate-400">
                    <svg class="h-4 w-4 text-indigo-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                    {{ skill }}
                </span>
            {% endfor %}
        </div>
    </div>
</div>

{# ====================================================================== #
   STATS BAND
# ====================================================================== #}
<section class="relative z-10 -mt-0 pt-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal grid grid-cols-2 gap-6 rounded-3xl border border-slate-200 bg-white px-6 py-10 shadow-xl shadow-slate-900/5 lg:grid-cols-4">
            <div class="text-center">
                <p class="font-display text-4xl font-bold text-indigo-600" data-count="150" data-suffix="+">0</p>
                <p class="mt-1.5 text-sm font-medium text-slate-500">Learners trained</p>
            </div>
            <div class="text-center">
                <p class="font-display text-4xl font-bold text-violet-600" data-count="24" data-suffix="+">0</p>
                <p class="mt-1.5 text-sm font-medium text-slate-500">Active courses</p>
            </div>
            <div class="text-center">
                <p class="font-display text-4xl font-bold text-emerald-600" data-count="94" data-suffix="%">0</p>
                <p class="mt-1.5 text-sm font-medium text-slate-500">Attendance rate</p>
            </div>
            <div class="text-center">
                <p class="font-display text-4xl font-bold text-amber-600"><span data-count="24">0</span>/7</p>
                <p class="mt-1.5 text-sm font-medium text-slate-500">Mentor support</p>
            </div>
        </div>
    </div>
</section>

{# ====================================================================== #
   COURSES
# ====================================================================== #}
<section id="courses" class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
            <span class="reveal inline-block rounded-full border border-indigo-200 bg-indigo-50 px-4 py-1.5 text-sm font-bold text-indigo-700">Our courses</span>
            <h2 class="reveal reveal-delay-1 mt-4 font-display text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
                Popular <span class="text-gradient">training programs</span>
            </h2>
            <p class="reveal reveal-delay-2 mt-4 text-lg text-slate-600">
                Project-based curriculums designed by industry mentors — learn by building, not just watching.
            </p>
        </div>

        <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {# Card 1 #}
            <div class="course-card reveal group rounded-2xl border border-slate-200 bg-white p-6">
                <div class="flex items-start justify-between">
                    <div class="rounded-xl bg-indigo-50 p-2.5 text-indigo-600">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>
                    </div>
                    <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-600">Best seller</span>
                </div>
                <h3 class="mt-5 font-display text-lg font-bold text-slate-900">Full-Stack Web Dev</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-500">PHP, Laravel, JavaScript & MySQL — from zero to deployable apps.</p>
                <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold text-slate-500">
                    <span class="rounded-md bg-slate-100 px-2.5 py-1">12 weeks</span>
                    <span class="rounded-md bg-slate-100 px-2.5 py-1">Beginner</span>
                    <span class="rounded-md bg-slate-100 px-2.5 py-1">60+ lessons</span>
                </div>
                <div class="mt-5 flex items-center justify-between border-t border-dashed border-slate-200 pt-4">
                    <div class="flex items-center gap-1 text-sm">
                        <svg class="h-4 w-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z"/></svg>
                        <span class="font-bold text-slate-900">4.9</span>
                    </div>
                    <a href="{{ url_for('register') }}" class="text-sm font-bold text-indigo-600 transition group-hover:translate-x-0.5">Enroll →</a>
                </div>
            </div>

            {# Card 2 #}
            <div class="course-card reveal reveal-delay-1 group rounded-2xl border border-slate-200 bg-white p-6">
                <div class="flex items-start justify-between">
                    <div class="rounded-xl bg-violet-50 p-2.5 text-violet-600">

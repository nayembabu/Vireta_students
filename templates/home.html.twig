{% extends 'base.html.twig' %}

{% block title %}Welcome • {{ app_name }}{% endblock %}

{% block body %}
<div class="min-h-full">
    <!-- Header -->
    <header class="bg-white shadow-sm">
        <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="h-9 w-9 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold">V</div>
                <h1 class="text-lg font-semibold text-slate-900">{{ app_name }}</h1>
            </div>
            <span class="inline-flex items-center rounded-full bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
                &bull; Sprint 1 Setup Running
            </span>
        </div>
    </header>

    <main>
        <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
            <div class="text-center">
                <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
                    Intern Student Portal
                </h2>
                <p class="mt-3 text-lg text-slate-600">
                    Slim 4 + Twig + HTMX + Tailwind — Foundation ready.
                </p>
            </div>

            <!-- Tech stack cards -->
            <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
                <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-50 text-indigo-700 font-bold">S4</div>
                    <h3 class="mt-4 font-semibold text-slate-900">Slim 4</h3>
                    <p class="mt-1 text-sm text-slate-500">PHP micro-framework, PSR-7 routing & middleware</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-amber-700 font-bold">Tw</div>
                    <h3 class="mt-4 font-semibold text-slate-900">Twig</h3>
                    <p class="mt-1 text-sm text-slate-500">Secure & fast templating engine for views</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-sky-50 text-sky-700 font-bold">HX</div>
                    <h3 class="mt-4 font-semibold text-slate-900">HTMX</h3>
                    <p class="mt-1 text-sm text-slate-500">Server-driven UI — dynamic pages without JS fatigue</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-teal-50 text-teal-700 font-bold">TW</div>
                    <h3 class="mt-4 font-semibold text-slate-900">Tailwind</h3>
                    <p class="mt-1 text-sm text-slate-500">Utility-first CSS for beautiful, responsive UI</p>
                </div>
            </div>

            <!-- HTMX live demo -->
            <div class="mt-10 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                <h3 class="font-semibold text-slate-900">HTMX live demo</h3>
                <p class="mt-1 text-sm text-slate-500">Click the button — it calls /ping via AJAX, no page reload, no hand-written JS.</p>
                <button
                    hx-get="{{ url_for('ping') }}"
                    hx-swap="outerHTML"
                    class="mt-4 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500">
                    Ping the server
                </button>
            </div>
        </div>
    </main>

    <footer class="py-8 text-center text-sm text-slate-400">
        &copy; {{ 'now'|date('Y') }} ViretaDev. All rights reserved.
    </footer>
</div>
{% endblock %}
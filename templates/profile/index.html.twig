{% extends 'app/layout.html.twig' %}

{% block page_title %}Profile{% endblock %}

{% block content %}
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-extrabold text-slate-900">Profile</h1>
        <p class="text-sm text-slate-500 mt-1">View and update your personal information here.</p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="space-y-6">
        <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6 text-center">
            {% if student.pro_pic %}
                <img src="{{ upload(student.pro_pic) }}" alt="profile" class="h-28 w-28 mx-auto rounded-2xl object-cover ring-4 ring-indigo-50">
            {% else %}
                <div class="h-28 w-28 mx-auto rounded-2xl bg-indigo-50 flex items-center justify-center text-4xl font-extrabold text-indigo-400">
                    {{ student.name ? student.name[:1]|upper : '?' }}
                </div>
            {% endif %}
            <h2 class="mt-4 text-lg font-bold text-slate-900">{{ student.name }}</h2>
            <p class="text-sm text-slate-500">Batch: {{ student.batch.name ?? '—' }}</p>

            <form method="post" action="{{ base_path }}/profile/photo" enctype="multipart/form-data" class="mt-5">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <label class="block text-left text-xs font-semibold text-slate-600 mb-1.5">New photo (max 2MB)</label>
                <input type="file" name="pro_pic" accept="image/jpeg,image/png,image/webp" required
                       class="block w-full text-xs text-slate-500 file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-600 file:text-white file:text-xs file:font-semibold file:px-3 file:py-2 file:cursor-pointer mb-3">
                <button type="submit" class="w-full rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold py-2.5 transition">Upload photo</button>
            </form>
        </div>

        <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6">
            <h3 class="font-bold text-slate-900 mb-4">Account info</h3>
            <dl class="space-y-3 text-sm">
                <div class="flex justify-between">
                    <dt class="text-slate-500">Reg. number</dt>
                    <dd class="font-semibold text-slate-800 flex items-center gap-1">{{ student.educational_registration_no }}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-slate-500">Mobile</dt>
                    <dd class="font-semibold text-slate-800 flex items-center gap-1">{{ student.phone_no }}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-slate-500">Email</dt>
                    <dd class="font-semibold text-slate-800">{{ user.email }}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-slate-500">Role</dt>
                    <dd class="font-semibold text-slate-800">{{ user.role }}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-slate-500">Status</dt>
                    <dd class="font-semibold text-emerald-600">{{ user.status }}</dd>
                </div>
            </dl>

            <div class="mt-5 pt-5 border-t border-slate-100">
                <h4 class="text-sm font-bold text-slate-800 mb-2">Change email</h4>
                <p class="text-xs text-slate-500 mb-3">A confirmation link will be sent to the new email.</p>
                <form method="post" action="{{ base_path }}/profile/email">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <input type="email" name="email" placeholder="new@example.com" required
                           class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm mb-2 focus:outline-none focus:ring-2 focus:ring-indigo-400">
                    <button type="submit" class="w-full rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold py-2.5 transition">Change email</button>
                </form>
            </div>
        </div>

        <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6">
            <h3 class="font-bold text-slate-900 mb-4">Change password</h3>
            <form method="post" action="{{ base_path }}/profile/password" class="space-y-3">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <input type="password" name="current_password" placeholder="Current password" required
                       class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
                <input type="password" name="new_password" placeholder="New password (min 8)" required
                       class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
                <input type="password" name="new_password_confirmation" placeholder="Repeat new password" required
                       class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
                <button type="submit" class="w-full rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold py-2.5 transition">Change password</button>
            </form>
        </div>
    </div>

    <div class="lg:col-span-2">
        <div class="bg-white rounded-2xl ring-1 ring-slate-100 shadow-sm p-6">
            <h3 class="font-bold text-slate-900 mb-1">Personal information</h3>
            <p class="text-sm text-slate-500 mb-5">Everything except registration number and mobile number can be updated.</p>

            <form method="post" action="{{ base_path }}/profile">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Full name <span class="text-rose-500">*</span></label>
                        <input type="text" name="name" value="{{ old.name is defined ? old.name : student.name }}" required
                               class="w-full rounded-xl border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.name ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
                        {% if errors.name %}<p class="text-xs text-rose-600 mt-1">{{ errors.name }}</p>{% endif %}
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Father's name <span class="text-rose-500">*</span></label>
                        <input type="text" name="father_name" value="{{ old.father_name is defined ? old.father_name : student.father_name }}" required
                               class="w-full rounded-xl border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.father_name ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
                        {% if errors.father_name %}<p class="text-xs text-rose-600 mt-1">{{ errors.father_name }}</p>{% endif %}
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Mother's name <span class="text-rose-500">*</span></label>
                        <input type="text" name="mother_name" value="{{ old.mother_name is defined ? old.mother_name : student.mother_name }}" required
                               class="w-full rounded-xl border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.mother_name ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
                        {% if errors.mother_name %}<p class="text-xs text-rose-600 mt-1">{{ errors.mother_name }}</p>{% endif %}
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Date of birth <span class="text-rose-500">*</span></label>
                        <input type="date" name="date_of_birth" value="{{ old.date_of_birth is defined ? old.date_of_birth : (student.date_of_birth ? student.date_of_birth|date('Y-m-d')) }}" required
                               class="w-full rounded-xl border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.date_of_birth ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
                        {% if errors.date_of_birth %}<p class="text-xs text-rose-600 mt-1">{{ errors.date_of_birth }}</p>{% endif %}
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Gender <span class="text-rose-500">*</span></label>
                        <select name="gender" required
                                class="w-full rounded-xl border px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.gender ? 'border-rose-300' : 'border-slate-200' }}">
                            <option value="male" {{ (old.gender is defined ? old.gender : student.gender) == 'male' ? 'selected' }}>Male</option>
                            <option value="female" {{ (old.gender is defined ? old.gender : student.gender) == 'female' ? 'selected' }}>Female</option>
                            <option value="other" {{ (old.gender is defined ? old.gender : student.gender) == 'other' ? 'selected' }}>Other</option>
                        </select>
                        {% if errors.gender %}<p class="text-xs text-rose-600 mt-1">{{ errors.gender }}</p>{% endif %}
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Blood group</label>
                        <input type="text" name="blood_group" maxlength="4"
                               value="{{ old.blood_group is defined ? old.blood_group : student.blood_group }}"
                               class="w-full rounded-xl border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 border-slate-200">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">SSC Roll <span class="text-rose-500">*</span></label>
                        <input type="text" name="ssc_roll" value="{{ old.ssc_roll is defined ? old.ssc_roll : student.ssc_roll }}" required
                               class="w-full rounded-xl border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.ssc_roll ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
                        {% if errors.ssc_roll %}<p class="text-xs text-rose-600 mt-1">{{ errors.ssc_roll }}</p>{% endif %}
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">SSC Registration <span class="text-rose-500">*</span></label>
                        <input type="text" name="ssc_registration" value="{{ old.ssc_registration is defined ? old.ssc_registration : student.ssc_registration }}" required
                               class="w-full rounded-xl border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 {{ errors.ssc_registration ? 'border-rose-300 bg-rose-50' : 'border-slate-200' }}">
                        {% if errors.ssc_registration %}<p class="text-xs text-rose-600 mt-1">{{ errors.ssc_registration }}</p>{% endif %}
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">WhatsApp number</label>
                        <input type="text" name="whatsapp_number" value="{{ old.whatsapp_number is defined ? old.whatsapp_number : student.whatsapp_number }}"
                               class="w-full rounded-xl border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 border-slate-200">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Emergency contact</label>
                        <input type="text" name="emergency_phone" value="{{ old.emergency_phone is defined ? old.emergency_phone : student.emergency_phone }}"
                               class="w-full rounded-xl border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 border-slate-200">
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">NID / Birth certificate number</label>
                        <input type="text" name="nid_birth_no" value="{{ old.nid_birth_no is defined ? old.nid_birth_no : student.nid_birth_no }}"
                               class="w-full rounded-xl border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 border-slate-200">
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Address</label>
                        <textarea name="address" rows="3" class="w-full rounded-xl border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 border-slate-200">{{ old.address is defined ? old.address : student.address }}</textarea>
                    </div>
                </div>
                <div class="mt-6 flex justify-end">
                    <button type="submit" class="rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-6 py-3 transition shadow-lg shadow-indigo-200">
                        Save changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
{% extends 'admin/layout.html.twig' %}

{% block admin_title %}Dashboard{% endblock %}
{% block admin_heading %}Dashboard{% endblock %}

{% block admin_content %}
{# ============ Greeting banner ============ #}
<div class="relative mb-6 overflow-hidden rounded-3xl bg-slate-900 p-6 text-white shadow-xl shadow-slate-900/20 sm:p-8">
    <div class="pointer-events-none absolute inset-0 bg-grid opacity-20"></div>
    <div class="pointer-events-none absolute -top-20 -right-20 h-64 w-64 rounded-full bg-teal-500/25 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-16 h-56 w-56 rounded-full bg-indigo-500/20 blur-3xl"></div>
    <div class="relative">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-teal-400">Trainer dashboard</p>
        <h2 class="mt-1 text-xl font-extrabold sm:text-2xl">Welcome, {{ trainer.name }}! 👋</h2>
        <p class="mt-1 text-sm text-slate-400">
            {% if trainer.batch %}{{ trainer.batch }} · {% endif %}{{ trainer.today_label }}
        </p>
    </div>
</div>

{# ============ Stat cards ============ #}
<div class="mb-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    <a href="{{ base_path }}/trainer/routines" class="group rounded-2xl bg-white p-4 ring-1 ring-slate-200/70 transition hover:-translate-y-0.5 hover:shadow-lg hover:ring-teal-300 sm:p-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Today's classes</div>
        <div class="mt-1 text-3xl font-extrabold text-slate-900">{{ stats.today_classes }}</div>
        <div class="mt-1 text-xs text-slate-400">scheduled today</div>
    </a>
    <a href="{{ base_path }}/trainer/assignments?ungraded=1" class="group rounded-2xl bg-white p-4 ring-1 ring-slate-200/70 transition hover:-translate-y-0.5 hover:shadow-lg hover:ring-amber-300 sm:p-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">To grade</div>
        <div class="mt-1 text-3xl font-extrabold text-amber-600">{{ stats.ungraded }}</div>
        <div class="mt-1 text-xs text-slate-400">ungraded submissions</div>
    </a>
    <a href="{{ base_path }}/trainer/attendance" class="group rounded-2xl bg-white p-4 ring-1 ring-slate-200/70 transition hover:-translate-y-0.5 hover:shadow-lg hover:ring-sky-300 sm:p-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Students</div>
        <div class="mt-1 text-3xl font-extrabold text-slate-900">{{ stats.students }}</div>
        <div class="mt-1 text-xs text-slate-400">in your batch</div>
    </a>
    <a href="{{ base_path }}/trainer/routines" class="group rounded-2xl bg-white p-4 ring-1 ring-slate-200/70 transition hover:-translate-y-0.5 hover:shadow-lg hover:ring-indigo-300 sm:p-5">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Upcoming</div>
        <div class="mt-1 text-3xl font-extrabold text-indigo-600">{{ stats.upcoming }}</div>
        <div class="mt-1 text-xs text-slate-400">next 7 days</div>
    </a>
</div>

{# ============ Today's classes + upcoming ============ #}
<div class="mb-6 grid grid-cols-1 gap-4 sm:gap-6 lg:grid-cols-2">
    <div class="rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
        <h3 class="mb-4 font-bold text-slate-900">📅 Today's classes</h3>
        {% if today_classes is empty %}
        <p class="text-sm text-slate-500">No classes scheduled today.</p>
        {% else %}
        <div class="space-y-2.5">
            {% for c in today_classes %}
            <div class="flex items-center gap-3 rounded-xl border border-teal-100 bg-teal-50/40 px-3 py-3">
                <div class="min-w-0 flex-1">
                    <div class="truncate text-sm font-semibold text-slate-800">{{ c.topic }}</div>
                    <div class="truncate text-xs text-slate-400">{{ c.course }}{% if c.batch %} · {{ c.batch }}{% endif %}{% if c.room %} · {{ c.room }}{% endif %}</div>
                </div>
                <span class="shrink-0 font-mono text-[11px] font-medium text-slate-500">{{ c.start_time|slice(0,5) }}-{{ c.end_time|slice(0,5) }}</span>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    <div class="rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
        <div class="mb-4 flex items-center justify-between">
            <h3 class="font-bold text-slate-900">🗓️ Upcoming classes</h3>
            <a href="{{ base_path }}/trainer/routines" class="text-xs font-semibold text-teal-700 hover:text-teal-600">Manage →</a>
        </div>
        {% if upcoming is empty %}
        <p class="text-sm text-slate-500">No upcoming classes.</p>
        {% else %}
        <div class="space-y-2.5">
            {% for c in upcoming %}
            <div class="flex items-center gap-3 rounded-xl border border-slate-100 px-3 py-3">
                <div class="w-14 shrink-0 text-center">
                    <div class="text-xs font-bold text-slate-500">{{ c.session_date|date('D') }}</div>
                    <div class="text-[11px] text-slate-400">{{ c.session_date|date('d M') }}</div>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="truncate text-sm font-semibold text-slate-800">{{ c.topic }}</div>
                    <div class="truncate text-xs text-slate-400">{{ c.course }}{% if c.batch %} · {{ c.batch }}{% endif %}</div>
                </div>
                <span class="shrink-0 font-mono text-[11px] font-medium text-slate-500">{{ c.start_time|slice(0,5) }}-{{ c.end_time|slice(0,5) }}</span>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

{# ============ Assignments to grade ============ #}
<div class="rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
    <div class="mb-4 flex items-center justify-between">
            <h3 class="font-bold text-slate-900">📝 Assignments to grade</h3>
            <a href="{{ base_path }}/trainer/assignments?ungraded=1" class="text-xs font-semibold text-teal-700 hover:text-teal-600">All →</a>
    </div>
    {% if ungraded is empty %}
    <p class="text-sm text-slate-500">No ungraded submissions. 🎉</p>
    {% else %}
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="border-b border-slate-100 text-xs uppercase tracking-wider text-slate-400">
                <tr>
                    <th class="py-2 pr-4">Student</th>
                    <th class="py-2 pr-4">Assignment</th>
                    <th class="py-2 pr-4">Course</th>
                    <th class="py-2 pr-4">Submitted</th>
                    <th class="py-2 text-right">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                {% for s in ungraded %}
                <tr>
                    <td class="py-2.5 pr-4 font-semibold text-slate-800">{{ s.student }}</td>
                    <td class="py-2.5 pr-4 text-slate-600">{{ s.assignment }}</td>
                    <td class="py-2.5 pr-4 text-xs text-slate-500">{{ s.course }}</td>
                    <td class="py-2.5 pr-4 text-xs text-slate-500">{{ s.submitted_at }}</td>
                    <td class="py-2.5 text-right">
                        <a href="{{ base_path }}/trainer/assignments/grade/{{ s.id }}" class="rounded-lg bg-teal-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-teal-500">Grade</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>

{# ============ Attendance ============ #}
<div class="mt-6 grid grid-cols-1 gap-4 sm:gap-6 lg:grid-cols-2">
    <div class="rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
        <div class="mb-4 flex items-center justify-between">
            <h3 class="font-bold text-slate-900">✅ Attendance</h3>
            <a href="{{ base_path }}/trainer/attendance" class="text-xs font-semibold text-teal-700 hover:text-teal-600">Manage →</a>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="rounded-xl bg-teal-50 p-3 text-center">
                <div class="text-2xl font-extrabold text-teal-600">{{ attendance.summary.present }}</div>
                <div class="mt-0.5 text-xs font-semibold text-teal-800">Present</div>
            </div>
            <div class="rounded-xl bg-amber-50 p-3 text-center">
                <div class="text-2xl font-extrabold text-amber-600">{{ attendance.summary.late }}</div>
                <div class="mt-0.5 text-xs font-semibold text-amber-800">Late</div>
            </div>
            <div class="rounded-xl bg-rose-50 p-3 text-center">
                <div class="text-2xl font-extrabold text-rose-600">{{ attendance.summary.absent }}</div>
                <div class="mt-0.5 text-xs font-semibold text-rose-800">Absent</div>
            </div>
            <div class="rounded-xl bg-sky-50 p-3 text-center">
                <div class="text-2xl font-extrabold text-sky-600">{{ attendance.summary.excused }}</div>
                <div class="mt-0.5 text-xs font-semibold text-sky-800">Excused</div>
            </div>
        </div>
        <div class="mt-4">
            <div class="flex justify-between text-xs text-slate-500"><span>Attendance rate</span><span class="font-bold text-slate-700">{{ attendance.summary.percentage }}%</span></div>
            <div class="mt-1 h-2 overflow-hidden rounded-full bg-slate-100">
                <div class="h-2 rounded-full bg-gradient-to-r from-teal-500 to-emerald-500" style="width: {{ attendance.summary.percentage }}%"></div>
            </div>
        </div>
    </div>

    <div class="rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
        <h3 class="mb-4 font-bold text-slate-900">🕐 Recent attendance</h3>
        {% if attendance.recent is empty %}
        <p class="text-sm text-slate-500">No attendance records yet.</p>
        {% else %}
        <div class="divide-y divide-slate-50">
            {% for a in attendance.recent %}
            <div class="flex items-center gap-3 py-2.5">
                <div class="min-w-0 flex-1">
                    <div class="truncate text-sm font-semibold text-slate-800">{{ a.student }}</div>
                    <div class="truncate text-xs text-slate-400">{{ a.course }} · {{ a.session_date }}</div>
                </div>
                {% if a.status == 'present' %}<span class="shrink-0 rounded-full bg-teal-50 px-2 py-0.5 text-[11px] font-bold text-teal-700">Present</span>
                {% elseif a.status == 'late' %}<span class="shrink-0 rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-bold text-amber-700">Late</span>
                {% elseif a.status == 'absent' %}<span class="shrink-0 rounded-full bg-rose-50 px-2 py-0.5 text-[11px] font-bold text-rose-600">Absent</span>
                {% else %}<span class="shrink-0 rounded-full bg-sky-50 px-2 py-0.5 text-[11px] font-bold text-sky-700">Excused</span>{% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

{# ============ Assignments ============ #}
<div class="mt-6 rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
    <div class="mb-4 flex items-center justify-between">
        <h3 class="font-bold text-slate-900">📝 Assignments</h3>
        <a href="{{ base_path }}/trainer/assignments" class="text-xs font-semibold text-teal-700 hover:text-teal-600">All →</a>
    </div>
    {% if assignments is empty %}
    <p class="text-sm text-slate-500">No assignments yet.</p>
    {% else %}
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="border-b border-slate-100 text-xs uppercase tracking-wider text-slate-400">
                <tr>
                    <th class="py-2 pr-4">Assignment</th>
                    <th class="py-2 pr-4">Course</th>
                    <th class="py-2 pr-4">Due</th>
                    <th class="py-2 pr-4">Submissions</th>
                    <th class="py-2 text-right">Ungraded</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                {% for a in assignments %}
                <tr>
                    <td class="py-2.5 pr-4 font-semibold text-slate-800">{{ a.title }}</td>
                    <td class="py-2.5 pr-4 text-xs text-slate-500">{{ a.course }}</td>
                    <td class="py-2.5 pr-4 text-xs text-slate-500">{{ a.due_date }}</td>
                    <td class="py-2.5 pr-4 text-xs text-slate-500">{{ a.submission_count }}</td>
                    <td class="py-2.5 text-right">
                        {% if a.ungraded_count > 0 %}
                        <span class="rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-bold text-amber-700">{{ a.ungraded_count }}</span>
                        {% else %}
                        <span class="text-xs text-slate-300">—</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>

{# ============ Batch-wise students ============ #}
<div class="mt-6 rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
    <div class="mb-4 flex items-center justify-between">
        <h3 class="font-bold text-slate-900">👥 Batch-wise students</h3>
        <a href="{{ base_path }}/trainer" class="text-xs font-semibold text-teal-700 hover:text-teal-600">All →</a>
    </div>
    {% if batch_groups is empty %}
    <p class="text-sm text-slate-500">No students yet.</p>
    {% else %}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% for batch, students in batch_groups %}
        <div class="rounded-xl border border-slate-100 p-4">
            <h4 class="mb-3 text-sm font-bold text-slate-800">🗂️ {{ batch }} <span class="text-xs font-semibold text-slate-400">({{ students|length }})</span></h4>
            <div class="space-y-2">
                {% for s in students %}
                <div class="flex items-center gap-2">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-teal-50 text-[11px] font-bold text-teal-700">{{ s.name|slice(0,1) }}</span>
                    <div class="min-w-0">
                        <div class="truncate text-sm font-semibold text-slate-700">{{ s.name }}</div>
                        <div class="truncate text-xs text-slate-400">{{ s.email }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}
